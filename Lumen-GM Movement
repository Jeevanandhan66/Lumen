ALTER proc [report].[usp_OffNet_CFA_IC_Metrics]
AS
BEGIN


EXEC dbo.sp_jv_update 'usp_OffNet_CFA_IC_Metrics - Step 1',0;

IF OBJECT_ID('tempdb..#tbl_ic_offnet_dashboard_cfa_dos_tasks') IS NOT NULL DROP TABLE #tbl_ic_offnet_dashboard_cfa_dos_tasks
IF OBJECT_ID('tempdb..#tbl_ic_offnet_dashboard_cfa_jeops_from_cods') IS NOT NULL DROP TABLE #tbl_ic_offnet_dashboard_cfa_jeops_from_cods
IF OBJECT_ID('tempdb..#Tbl_Ic_Offnet_Assign_Cfa_New') IS NOT NULL DROP TABLE #Tbl_Ic_Offnet_Assign_Cfa_New

CREATE TABLE #tbl_ic_offnet_dashboard_cfa_dos_tasks(
	[Customer_Order_Id] [varchar](250) NULL,
	[Service_Order_Id] [varchar](250) NULL,
	[Process_Nid] [numeric](18, 0) NULL,
	[Task_Nid] [numeric](22, 0) NOT NULL,
	[Performer_Name] [varchar](300) NULL,
	[Task_Name] [varchar](1000) NOT NULL,
	[Task_Status] [varchar](30) NULL,
	[Task_Start_Time] [datetime] NULL,
	[Task_End_Time] [datetime] NULL,
	[Source_System] [varchar](64) NULL,
	[So_Service_Id] [varchar](1024) NULL,
	[Process_Id] [varchar](250) NULL,
	[Task_Id] [varchar](1000) NULL,
	[Bandwdth_Cd] [nvarchar](30) NULL,
	[Sub_Bandwdth_Cd] [nvarchar](30) NULL,
	[Task_Source] [varchar](100) NULL
	)

CREATE TABLE #tbl_ic_offnet_dashboard_cfa_jeops_from_cods(
	[customer_order_id] [varchar](250) NULL,
	[service_order_id] [varchar](100) NULL,
	[process_nid] [numeric](18, 0) NULL,
	[task_nid] [numeric](22, 0) NULL,
	[jeopardy_reason_cd] [varchar](256) NULL,
	[jeopardy_raised_dt] [datetime] NULL,
	[raised_by_performer_name] [varchar](256) NULL,
	[jeopardy_resolution_dt] [datetime] NULL,
	[jeopardy_resolved_ind] [varchar](1) NULL,
	[resolved_by_performer_name] [varchar](256) NULL,
	[process_id] [varchar](250) NULL,
	[task_id] [varchar](1000) NULL,
	[task_source] [varchar](100) NULL
)

CREATE TABLE #Tbl_Ic_Offnet_Assign_Cfa_New(
	[CUSTOMER_ORDER_ID] [varchar](240) NULL,
	[SERVICE_ORDER_ID] [varchar](240) NULL,
	[PERFORMER_NAME] [varchar](1024) NULL,
	[TASK_START_TIME] [datetime] NULL,
	[TASK_END_TIME] [datetime] NULL,
	[Intvl_Bus_Hrs] [int] NULL,
	[SLA_Met] [int] NULL,
	[Data_Src_Cd] [varchar](100) NULL,
	[Min_Jeop_Open] [datetime] NULL,
	[Max_Jeop_Close] [datetime] NULL,
	[Jeop_Intvl] [int] NULL,
	[process_NID] [numeric](22, 0) NULL,
	[task_NID] [numeric](22, 0) NULL,
	[Task_Name] [varchar](1408) NULL,
	[so_service_id] [varchar](1000) NULL,
	[Task_Id] [varchar](1000) NULL,
	[Adjusted_Intvl] [int] NULL,
	[Adjusted_Intvl_SLA_Met] [int] NULL,
	[Inventory_Design_Id] [varchar](100) NULL,
	[Srvc_Order_Unit] [varchar](100) NULL,
	[Net_Bus_Minutes] [int] NULL,
	[Bus_Minutes_SLA_Met_Int] [int] NULL,
	[Bus_Minutes_SLA_Met] [varchar](100) NULL,
	[Bus_Minutes_SLA_Met_NoJeopExcluded_Int] [int] NULL,
	[Bus_Minutes_SLA_Met_NoJeopExcluded] [varchar](100) NULL,
	[Net_Bus_Minutes_NoJeopTimeExcluded] [int] NULL,
)
EXEC dbo.sp_jv_update 'usp_OffNet_CFA_IC_Metrics - Step 1',1;
EXEC dbo.sp_jv_update 'usp_OffNet_CFA_IC_Metrics - Step 2',0;

truncate table #tbl_ic_offnet_dashboard_cfa_dos_tasks
insert into #tbl_ic_offnet_dashboard_cfa_dos_tasks 
SELECT DISTINCT
	  Td.Customer_Order_Number AS Customer_Order_Id
	, Td.Task_Sou AS Service_Order_Id
	, Td.Process_Nid
	, Td.Task_Nid
	, Td.Task_Assignee AS Performer_Name
	, Td.Task_Name
	, Td.Cods_Task_Status AS Task_Status
	, Td.Task_Start_Date AS Task_Start_Time
	, Td.Task_End_Date AS Task_End_Time
	, Td.Customer_Order_Source AS Source_System
	, MAX(Co.So_Service_Id) AS So_Service_Id
	, Td.Process_Id
	, Td.Task_Id
	, Cop.Bandwdth_Cd
	, Cop.Sub_Bandwdth_Cd
	, Td.Task_Source
	  FROM Dbo.Task_Details AS Td
		  LEFT OUTER JOIN Dbo.Cods_Workflow__Customer_Order AS Co
			  ON Td.Task_Sou = Co.Service_Order_Id
		  LEFT OUTER JOIN Dbo.Tbl_Cods_Dsl_V_Customer_Order_Product AS Cop
			  ON Td.Task_Sou = Cop.Serv_Order_Nbr
WHERE Td.Task_Name IN('DesignOffnetSegment'
					    , 'Design Offnet Segment'
					    , 'Identify Interconnect Provider'
					    , 'Identify_Offnet_Details_GT'
					    , 'Process Offnet'
					    , 'Evaluate Cancel'
						,'Off-Net Design CFA Template','Off-Net Design CFA Template - SUP','Get Carrier VLAN and NNI Details','Offnet Manual Design Template',
'Offnet Manual Design Template - SUP','NEWCFA Request - Adhoc','Gather costing details')
		  AND Td.Task_Start_Date >= GETDATE() - 730
		  AND Td.Cods_Task_Status <> 'I_SUSPENDED'
		  AND Td.Customer_Order_Source IN('SIEBEL', 'PIPELINE', 'SWIFT', 'SWIFT (BPM)', 'EON', 'ASRI', 'CPO','N/A')
		  and 1 = case when td.task_source = 'Flight Deck' 
			  then case when source_task_status in ('Completed','Complete')
			  then 1 else 0 end
			  else 1 end
AND Td.Task_Source in ('BPM', 'ASRI','Flight Deck')
	  GROUP BY Td.Customer_Order_Number
		    , Td.Task_Sou
		    , Td.Process_Nid
		    , Td.Task_Nid
		    , Td.Task_Assignee
		    , Td.Task_Name
		    , Td.Cods_Task_Status
		    , Td.Task_Start_Date
		    , Td.Task_End_Date
		    , Td.Task_Assignee
		    , Td.Customer_Order_Source
		    , Td.Task_Source
		    , Td.Process_Id
		    , Td.Task_Id
		    , Cop.Bandwdth_Cd
		    , Cop.Sub_Bandwdth_Cd;

--------------------------------------------------------------------------------------------------------------------------------------------------------------------

truncate table #tbl_ic_offnet_dashboard_cfa_jeops_from_cods;
insert into #tbl_ic_offnet_dashboard_cfa_jeops_from_cods
SELECT DISTINCT
	  Td.Customer_Order_Number AS Customer_Order_Id
	, Td.Task_Sou AS Service_Order_Id
	, Td.Process_Nid
	, Td.Task_Nid
	, Tj.Reason_Code AS Jeopardy_Reason_Code
	, Tj.Raised_Date AS Jeopardy_Raised_Date
	, Tj.Created_By AS Raised_By_Performer_Name
	, isnull(Tj.Resolution_Date,GETDATE()) AS Jeop_Resolution_Date
	, CASE
		 WHEN Tj.Resolution_Date IS NOT NULL
		 THEN 'Y'
		 ELSE 'N'
	  END AS Jeopardy_Resolved_Ind
	, Tj.Resolved_By AS Resolved_By_Performer_Name
	, Td.Process_Id
	, Td.Task_Id
	, Td.Task_Source
	  FROM Dbo.Task_Details AS Td
		  INNER JOIN Dbo.Task_Jeopardy_Codes AS Tj
			  ON Td.Task_Id = Tj.Task_Id
	  WHERE(Td.Task_Name IN ('DesignOffnetSegment'
					    , 'Design Offnet Segment'
					    , 'Identify Interconnect Provider'
					    , 'Identify_Offnet_Details_GT'
					    , 'Evaluate Cancel'
						,'Off-Net Design CFA Template','Off-Net Design CFA Template - SUP','Get Carrier VLAN and NNI Details','Offnet Manual Design Template',
'Offnet Manual Design Template - SUP', 'NEWCFA Request - Adhoc','Gather costing details')
		   OR Td.Task_Name LIKE '%Process Off%')
	and 1 = case when td.task_source = 'Flight Deck' 
			  then case when source_task_status in ('Completed','Complete') 
			  then 1 else 0 end
			  else 1 end
		  AND Td.Task_End_Date >= GETDATE() - 400;

---------------------------------------------------------------------------------------------------------------------------------------------------------------------
truncate table #Tbl_Ic_Offnet_Assign_Cfa_New 
INSERT INTO #Tbl_Ic_Offnet_Assign_Cfa_New
	  SELECT DISTINCT
		    C.*
		  , Intvl_Bus_Hrs - Jeop_Intvl AS Adjusted_Intvl
		  , CASE
			   WHEN Intvl_Bus_Hrs - Jeop_Intvl <= 8
			   THEN 1
			   ELSE 0
		    END AS Adjusted_Intvl_Sla_Met
		  , So_Service_Id AS Inventory_Design_Id
		  , Service_Order_Id AS Srvc_Order_Unit
		  , NULL AS Net_Bus_Minutes
		  , NULL AS Bus_Minutes_Sla_Met_Int
		  , NULL AS Bus_Minutes_Sla_Met
		  , NULL AS Bus_Minutes_Sla_Met_Nojeopexcluded_Int
		  , NULL AS Bus_Minutes_Sla_Met_Nojeopexcluded
		  , NULL AS Net_Bus_Minutes_Nojeoptimeexcluded
		    FROM
			( SELECT A.Customer_Order_Id
					, A.Service_Order_Id
					, Performer_Name
					, Task_Start_Time
					, Task_End_Time
					, Intvl_Bus_Hrs
					, CASE
						 WHEN Intvl_Bus_Hrs <= 8
						 THEN 1
						 ELSE 0
					  END AS Sla_Met
					, A.Data_Src_Cd 
					, MIN(DATEADD(Hh, -7, Jeopardy_Raised_Dt)) AS Min_Jeop_Open
					, MAX(DATEADD(Hh, -7, Jeopardy_Resolution_Dt)) AS Max_Jeop_Close
					, isnull(Dbo.Fn_Calcbusinesshours(MIN(DATEADD(Hh, -7, Jeopardy_Raised_Dt))
					, CASE
						WHEN MAX(DATEADD(Hh, -7, Jeopardy_Resolution_Dt)) > Task_End_Time
						THEN Task_End_Time
						ELSE MAX(DATEADD(Hh, -7, Jeopardy_Resolution_Dt))
					 END), 0) AS Jeop_Intvl
					, A.Process_Nid
					, A.Task_Nid
					, A.Task_Name
					, So_Service_Id
					,A.Task_Id
					  FROM( SELECT DISTINCT
								case when T.Source_System = 'N/A' then 'Flight Deck' else T.Source_System end AS Data_Src_Cd
							   , Process_Nid
							   , Task_Nid
							   , Process_Id
							   , Task_Id
							   , T.Customer_Order_Id
							   , T.Service_Order_Id
							   , T.So_Service_Id
							   , T.Performer_Name
							   , Task_Name
							   , DATEADD(Hh, -7, T.Task_Start_Time) AS Task_Start_Time
							   , DATEADD(Hh, -7, T.Task_End_Time) AS Task_End_Time
							   , Dbo.Fn_Calcbusinesshours(DATEADD(Hh, -7, T.Task_Start_Time), DATEADD(Hh, -7, T.Task_End_Time)) AS Intvl_Bus_Hrs
								FROM #Tbl_Ic_Offnet_Dashboard_Cfa_Dos_Tasks AS T WITH (Nolock)
			 
						) AS A 
						 LEFT OUTER JOIN  #Tbl_Ic_Offnet_Dashboard_Cfa_Jeops_From_Cods AS J 
							 ON A.Process_Id = J.Process_Id
							    AND A.Task_Id = J.Task_Id
								and J.jeopardy_resolution_dt > A.Task_Start_Time
					  GROUP BY A.Customer_Order_Id
						    , A.Service_Order_Id
						    , Performer_Name
						    , Task_Name
						    , Task_Start_Time
						    , Task_End_Time
						    , Intvl_Bus_Hrs
						    , A.Data_Src_Cd
						    , A.Task_Name
						    , A.Process_Nid
						    , A.Task_Nid
						    , So_Service_Id 
							,A.Task_Id
			) AS C

;WITH cte AS (
    SELECT 
        td.taskid,
        sh.status,
        sh.ActivitySource,
        sh.CreatedDttm,
        LAG(status) OVER (PARTITION BY taskid ORDER BY CreatedDttm) AS prev_status,
        LAG(CreatedDttm) OVER (PARTITION BY taskid ORDER BY CreatedDttm) AS prev_CreatedDttm
    FROM staging.Flightdeck_TaskStatusHist sh
    INNER JOIN staging.FlightdeckTaskAttributeDetail td
        ON sh.task_instance_id = td.ID
    WHERE sh.WorkgroupName = 'NA Offnet ETH CFA Design'	  
),
flagged AS (
    SELECT
        *,
        CASE 
            WHEN status <> 'Completed' AND prev_status = 'Completed' THEN 1 
            ELSE 0 
        END AS Post_Completed_Transition_Flag
    FROM cte
)
,final as (SELECT
    taskid,
    status,
    prev_status,
    ActivitySource,
    CreatedDttm,
	prev_CreatedDttm,
    Post_Completed_Transition_Flag,
    SUM(Post_Completed_Transition_Flag) 
        OVER (PARTITION BY taskid )
		--ORDER BY CreatedDttm) 
--              ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
        AS Post_Completed_Transition_Total
FROM flagged
where Post_Completed_Transition_Flag = 1  
)
				
--Update Business Minute fields
UPDATE ic
	  SET
		 Net_Bus_Minutes = Dbo.Fn_Net_Business_Minutes_Intvl(Task_Start_Time, Task_End_Time, Min_Jeop_Open, Max_Jeop_Close)  
							-x.Prev_Minutes,

		Net_Bus_Minutes_Nojeoptimeexcluded = Dbo.Fn_Net_Business_Minutes_Intvl(Task_Start_Time, Task_End_Time, NULL, NULL)
												- x.Prev_Minutes
		 from #Tbl_Ic_Offnet_Assign_Cfa_New ic left join final f
		 on ic.task_id = f.taskid
		 Cross Apply (
		 select ISNULL(Dbo.Fn_Net_Business_Minutes_Intvl(prev_CreatedDttm,CreatedDttm, null, null),0) as Prev_Minutes
		 )X
		 ;

UPDATE #Tbl_Ic_Offnet_Assign_Cfa_New
	  SET

	  	 Bus_Minutes_Sla_Met_Int = CASE
								 WHEN Net_Bus_Minutes <= 1440
								 THEN 1
								 ELSE 0
							  END,
		 Bus_Minutes_Sla_Met = CASE
							  WHEN Net_Bus_Minutes <= 1440
							  THEN 'Made'
							  ELSE 'Missed'
						   END,
		 Bus_Minutes_Sla_Met_Nojeopexcluded_Int = CASE
											 WHEN Net_Bus_Minutes_Nojeoptimeexcluded <= 1440
											 THEN 1
											 ELSE 0
										  END,
		 Bus_Minutes_Sla_Met_Nojeopexcluded = CASE
										  WHEN Net_Bus_Minutes_Nojeoptimeexcluded <= 1440
										  THEN 'Made'
										  ELSE 'Missed'
									   END;

EXEC dbo.sp_jv_update 'usp_OffNet_CFA_IC_Metrics - Step 2',1;
EXEC dbo.sp_jv_update 'usp_OffNet_CFA_IC_Metrics - Step 3',0;

 

---------------------------------------------------------------------------------------------------------------------------------------------------------------------
--Report Query

declare	@RB datetime =  format(dateadd(MONTH,-13,GETDATE()),'yyyy-MM-01'); 
declare    @RE datetime = cast(GETDATE() as date);
DECLARE @Counter INT = 0;

IF OBJECT_ID('tempdb..#t') IS NOT NULL DROP TABLE #t
create table #t (mon date)

WHILE @Counter <= datediff(day,format(dateadd(MONTH,-13,GETDATE()),'yyyy-MM-01'),getdate())
BEGIN
	insert into #t Select  cast(dateadd(day,-@counter,@re) as date) --convert(varchar(7),DATEADD(M,-@Counter,@RE),120)    
    SET @Counter = @Counter + 1;
END;

IF OBJECT_ID('tempdb..#List') IS NOT NULL DROP TABLE #List
Create Table #List
( Director varchar(100) null,  Manager varchar(100) null, Manager_Full_Name varchar(100) null,  NT_Login varchar(100) null, NT_Login_Full_Name varchar(100) null, 
Contractor_Flag varchar(100) null, GAL_Contractor_Flag varchar(1) null,  Non_EO_Contractor varchar(100) null)
Insert Into #List select * from 
	 (select Director, Manager, Manager_Full_Name, EO as NT_Login, EO_Full_Name as NT_Login_Full_Name,
Case When os.NT_Login IS Null and Org.contractor_flag = 'n' Then 'OnShore EO' 
	 When os.NT_Login IS Null and Org.contractor_flag = 'y' Then 'OnShore Contractor' Else os.Contractor 
	 End Contractor_Flag,
	Org.Contractor_Flag as GAL_Contractor_Flag, os.NT_Login as Non_EO_Contractor 
	from dbo.vw_offnet_prov_org org with (nolock) 
		Left Outer Join dbo.vw_Offshore_Contractors os on EO = OS.NT_Login
		)a

IF OBJECT_ID('tempdb..#bom') IS NOT NULL DROP TABLE #bom

SELECT Customer_Order_Id
		  , Service_Order_Id
		  , Srvc_Order_Unit
		  , Performer_Name
		  , Task_Nid as bom_task_nid
		  , Cfa_Task_Count
		  , Performer_Cfa_Task_Count
		  , Cfa_Jeop_Count
		  , Task_Name as bom_task_name
		  , Task_Start_Time
		  , Task_End_Time
		  , Dbo.Fn_Net_Business_Minutes_Intvl(Task_Start_Time, Task_End_Time, null, null) AS Net_Business_Minutes_Raw
		  , Intvl_Bus_Hrs
		  , Sla_Met
		  , Data_Src_Cd
		  , Min_Jeop_Open AS Jeop_Start_Time
		  , Max_Jeop_Close AS Jeop_End_Time
		  , Adj_Jeop_Close AS Adj_Jeop_End_Time
		  , Dbo.Fn_Net_Business_Minutes_Intvl(Min_Jeop_Open, Adj_Jeop_Close, NULL, NULL) AS Jeop_Net_Business_Minutes
		  , Jeop_Intvl
		  , Adjusted_Intvl
		  , Adjusted_Intvl_Sla_Met
		  , Supervisor_Name
		  , Sla
		  , Sla_Status
		  , Adjusted_Intvl_Sla_Status
		  , Inventory_Design_Id
		  , Net_Bus_Minutes
		  , Bus_Minutes_Sla_Met_Int
		  , Bus_Minutes_Sla_Met
		  ,Net_Bus_Minutes_NoJeopTimeExcluded
		  ,Bus_Minutes_SLA_Met_NoJeopExcluded_Int
		  ,task_id
		  into #BOM 
  	      FROM ( SELECT Detail.*
					, Performer_Cfa_Task_Count
					, Cfa_Task_Count
					, Cfa_Jeop_Count
					, Gc.Supervisor_Name				
					, '8 Bus Hrs' AS Sla
					, CASE
						 WHEN Sla_Met = 1
						 THEN 'Yes'
						 ELSE 'No'
					  END AS Sla_Status
					, CASE
						 WHEN Adjusted_Intvl_Sla_Met = 1
						 THEN 'Yes'
						 ELSE 'No'
					  END AS Adjusted_Intvl_Sla_Status
					, CASE
						 WHEN Max_Jeop_Close > Task_End_Time
						 THEN Task_End_Time
						 ELSE Max_Jeop_Close
					  END AS Adj_Jeop_Close
					  FROM( SELECT A.*
							   , CASE
								    WHEN Data_Src_Cd IN('SWIFT', 'SWIFT (BPM)', 'CPO','ASRI')
								    THEN Customer_Order_Id
								    ELSE Service_Order_Id
								END AS Sou_Join
								FROM #Tbl_Ic_Offnet_Assign_Cfa_New AS A ) AS Detail
						 LEFT OUTER JOIN Dbo.Galcapture AS Gc
							 ON Detail.Performer_Name = Gc.Nt_Login
						 LEFT OUTER JOIN( SELECT CASE
											    WHEN Data_Src_Cd IN('SWIFT', 'SWIFT (BPM)', 'CPO','ASRI')
											    THEN Customer_Order_Id
											    ELSE Service_Order_Id
											END AS Sou_Join
										   , COUNT(*) AS Cfa_Task_Count
											FROM #Tbl_Ic_Offnet_Assign_Cfa_New AS Detail
											GROUP BY CASE
													   WHEN Data_Src_Cd IN('SWIFT', 'SWIFT (BPM)', 'CPO','ASRI')
													   THEN Customer_Order_Id
													   ELSE Service_Order_Id
												    END ) AS Cfa_Tasks
							 ON Detail.Sou_Join = Cfa_Tasks.Sou_Join
						 LEFT OUTER JOIN( SELECT Performer_Name
										   , CASE
											    WHEN Data_Src_Cd IN('SWIFT', 'SWIFT (BPM)', 'CPO','ASRI')
											    THEN Customer_Order_Id
											    ELSE Service_Order_Id
											END AS Sou_Join
										   , COUNT(*) AS Performer_Cfa_Task_Count
											FROM #Tbl_Ic_Offnet_Assign_Cfa_New AS Detail
											GROUP BY Performer_Name
												  , CASE
													   WHEN Data_Src_Cd IN('SWIFT', 'SWIFT (BPM)', 'CPO','ASRI')
													   THEN Customer_Order_Id
													   ELSE Service_Order_Id
												    END ) AS Cfa_Tasks_For_This_Performer
							 ON Detail.Performer_Name = Cfa_Tasks_For_This_Performer.Performer_Name
							    AND Detail.Sou_Join = Cfa_Tasks_For_This_Performer.Sou_Join
						 LEFT OUTER JOIN( SELECT Service_Order_Id
										   , COUNT(*) AS Cfa_Jeop_Count
											FROM #Tbl_Ic_Offnet_Dashboard_Cfa_Jeops_From_Cods
											GROUP BY Service_Order_Id ) AS Cfa_Jeops
							ON Detail.Service_Order_Id = Cfa_Jeops.Service_Order_Id							  
				) AS A 
where dbo.trunc(Task_End_Time) >= @RB and dbo.trunc(Task_End_Time) <= @RE

		    GROUP BY Customer_Order_Id
				 , Service_Order_Id
				 , Srvc_Order_Unit
				 , Performer_Name
				 , Task_Nid
				 , Performer_Cfa_Task_Count
				 , Cfa_Task_Count
				 , Cfa_Jeop_Count
				 , Task_Name
				 , Task_Start_Time
				 , Task_End_Time
				 , Intvl_Bus_Hrs
				 , Sla_Met
				 , Data_Src_Cd
				 , Min_Jeop_Open
				 , Max_Jeop_Close
				 , Adj_Jeop_Close
				 , Jeop_Intvl
				 , Adjusted_Intvl
				 , Adjusted_Intvl_Sla_Met
				 , Supervisor_Name
				 , Sla
				 , Sla_Status
				 , Adjusted_Intvl_Sla_Status
				 , Inventory_Design_Id
				 , Net_Bus_Minutes
				 , Bus_Minutes_Sla_Met_Int
				 , Bus_Minutes_Sla_Met
				 ,Net_Bus_Minutes_NoJeopTimeExcluded
