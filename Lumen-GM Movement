SELECT j.task_id
	,j.jeopardy_raised_dt
	,row_number() OVER (
		PARTITION BY j.task_id ORDER BY j.jeopardy_raised_dt
		) AS Jeop_raise_order
	,j.jeopardy_nid
	,row_number() OVER (
		PARTITION BY j.task_id ORDER BY j.jeopardy_nid
		) AS jeop_nid_order
	,row_number() OVER (
		PARTITION BY j.task_id ORDER BY CASE 
				WHEN j.jeopardy_reason_cd = 'GFSINCDSGN'
					OR j.short_description IN (
						'Design Error/Incomplete'
						,'Design Error/Inc'
						)
					THEN 0
				ELSE 1
				END
			,j.jeopardy_nid DESC
		) AS jeop__order
INTO #sel_jeop
FROM [CODS_Workflow__Jeopardy] j WITH (NOLOCK)
INNER JOIN #task_details_join tsk WITH (NOLOCK) ON tsk.task_id = j.task_id
