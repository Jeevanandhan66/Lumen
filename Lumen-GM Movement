ALTER PROCEDURE [dbo].[usp_Locates_Display_Screener]

AS
BEGIN

---- creation of LDR_UTILISPHERE_TICKET_GREEN_OTC_T table

IF OBJECT_ID('tempdb..#TempLocator1') IS NOT NULL
BEGIN
    DROP TABLE #TempLocator1;
END



 SELECT DISTINCT 
        tir_dbl.TICKET_ID,
        tir_dbl.RESPONSE_NAME AS Response_Code,
        tir_dbl.LOCATE_DATETIME AS LastRes_Date,
        COALESCE(
            RTRIM(tir_dbl.LOCATOR_NAME),
            CASE 
                WHEN (tir_dbl.LOCATOR_FIRST_NAME = '' OR tir_dbl.LOCATOR_FIRST_NAME IS NULL) 
                    AND (tir_dbl.LOCATOR_LAST_NAME = '' OR tir_dbl.LOCATOR_LAST_NAME IS NULL) 
                THEN NULL
                ELSE RTRIM(CONCAT(tir_dbl.LOCATOR_FIRST_NAME, ' ', tir_dbl.LOCATOR_LAST_NAME))
            END,
            RTRIM(CONCAT(tir_dbl.OPERATOR_FIRST_NAME, ' ', tir_dbl.OPERATOR_LAST_NAME))
        ) AS Lr_Locator_Name,
        tir_dbl.RESPONSE_CONTRACTOR AS Lr_Response_Contractor,
        tir_dbl.CREATEDBY_EMAIL,
        tir_dbl.LOCATOR_LAST_NAME,
        tir_dbl.CREATE_DATETIME
		into #TempLocator1
    FROM dbo.UTILISPHERE_TICKET_RESPONSE_T TIR_DBL
    INNER JOIN (
        SELECT TICKET_ID, MAX(TICKET_RESPONSE_ID) AS TICKET_RESPONSE_ID
        FROM dbo.UTILISPHERE_TICKET_RESPONSE_T
        GROUP BY TICKET_ID
    ) max_resp ON max_resp.TICKET_ID = TIR_DBL.TICKET_ID AND max_resp.TICKET_RESPONSE_ID = TIR_DBL.TICKET_RESPONSE_ID
	 WHERE tir_dbl.CLOSED = 'Yes'	;


IF OBJECT_ID('tempdb..#GAL') IS NOT NULL
BEGIN
    DROP TABLE #GAL;
END



SELECT DISTINCT 
        REPLACE(emp.CUID, '.', '') AS Employee_Cuid,
		emp.full_name as Employee_Name,
        CASE 
                WHEN CHARINDEX('@', emp.EMAIL_ADDRESS) > 0 THEN SUBSTRING(UPPER(SUBSTRING(emp.EMAIL_ADDRESS, 1, CHARINDEX('@', emp.EMAIL_ADDRESS) - 1)), 1, LEN(UPPER(SUBSTRING(emp.EMAIL_ADDRESS, 1, CHARINDEX('@', emp.EMAIL_ADDRESS) - 1))))
            END AS FullDotName,
		emp.EMAIL_ADDRESS,
		emp.JOB_TITLE,
        REPLACE(sup.CUID, '.', '') AS Management_Cuid,
		sup.full_name as Management_Name
		into #GAL
    FROM dbo.GALCapture emp
    INNER JOIN dbo.GALCapture sup ON EMP.SUPERVISOR_EMPLOYEE_NUMBER = SUP.EMPLOYEE_NUMBER
    WHERE emp.CUID <> ' '
	and emp.EMAIL_ADDRESS is not null
	AND UPPER(emp.CUID) NOT LIKE ('XB%')
            AND UPPER(emp.CUID) NOT LIKE ('XS%')
            AND emp.JOB_TITLE NOT IN ('CEO', 'CHIEF EXECUTIVE OFFICER', 'CHIEF OPERATING OFFICER', 'PRESIDENT', 'PRESIDENT CEO', 'PRESIDENT/CEO', 'PRESIDENT/OWNER')


IF OBJECT_ID('tempdb..#TempLocator') IS NOT NULL
BEGIN
    DROP TABLE #TempLocator;
END


select distinct
cte_tir.TICKET_ID,
    cte_tir.RESPONSE_CODE,
    cte_tir.LASTRES_DATE,
    cte_tir.CREATEDBY_EMAIL,
    cte_tir.LR_LOCATOR_NAME,
    cte_tir.LR_RESPONSE_CONTRACTOR,
    CASE 
        WHEN coalesce(GAL.Management_Name, GAL1.Management_Name) IS NULL
            AND UPPER(cte_tir.RESPONSE_CODE) LIKE '%CPM%'
            OR (LOWER(cte_tir.LR_LOCATOR_NAME) LIKE '%nolan snyder%'
                OR LOWER(cte_tir.LR_LOCATOR_NAME) LIKE 'cpm automation%')
        THEN 'NOLAN SNYDER'
        WHEN coalesce(GAL.Management_Name, GAL1.Management_Name) IS NULL
            AND (UPPER(cte_tir.LR_LOCATOR_NAME) LIKE '%STAKE CENTER%'
                OR UPPER(cte_tir.LR_LOCATOR_NAME) LIKE '%SCL%'
                OR UPPER(cte_tir.LR_LOCATOR_NAME) LIKE '%USIC%'
                OR UPPER(cte_tir.LR_LOCATOR_NAME) LIKE '%LINDERLAKE%'
					OR UPPER(cte_tir.LR_LOCATOR_NAME) LIKE '%SUNBELT%'
					OR UPPER(cte_tir.LR_LOCATOR_NAME) LIKE '%INTEGRITY LOCATING%'
					OR UPPER(cte_tir.LR_LOCATOR_NAME) LIKE '%NORTHERN LIGHTS LOCATING%'
					OR UPPER(cte_tir.LR_LOCATOR_NAME) LIKE '%OLAMETER%'
					OR UPPER(cte_tir.LR_LOCATOR_NAME) LIKE '%AMC%'
					OR UPPER(cte_tir.LR_LOCATOR_NAME) LIKE '%BAYSTATE%'
					OR UPPER(cte_tir.LR_LOCATOR_NAME) LIKE '%UTILITIES PLUS%'
					OR UPPER(cte_tir.LR_LOCATOR_NAME) LIKE '%SUMMIT%'
					OR UPPER(cte_tir.LR_LOCATOR_NAME) LIKE '%1ST CALL%'
					OR UPPER(cte_tir.LR_LOCATOR_NAME) LIKE '%DANIEL AMAYA%'
					OR UPPER(cte_tir.LR_LOCATOR_NAME) LIKE '%MCAMPBELL%'
					OR UPPER(cte_tir.LR_LOCATOR_NAME) LIKE '%MIKE JONES%'
					OR UPPER(cte_tir.LR_LOCATOR_NAME) LIKE '%BEN WHITAKER%'
					)
				THEN 'External Locate Vendor'
			ELSE UPPER(coalesce(GAL.Management_Name, GAL1.Management_Name))
			END AS Supervisor
			into #TempLocator
from #TempLocator1 cte_tir
	LEFT JOIN  #GAL GAL
			ON  LOWER(GAL.EMPLOYEE_CUID) = LOWER(LTRIM(RTRIM(SUBSTRING(cte_tir.LOCATOR_LAST_NAME, CHARINDEX(' ', cte_tir.LOCATOR_LAST_NAME) + 1, LEN(cte_tir.LOCATOR_LAST_NAME) - CHARINDEX(' ', cte_tir.LOCATOR_LAST_NAME)))))
	LEFT JOIN  #GAL GAL1
			    on LOWER(GAL1.FULLDOTNAME) = LOWER(SUBSTRING(UPPER(SUBSTRING(cte_tir.CREATEDBY_EMAIL, 1, CHARINDEX('@', cte_tir.CREATEDBY_EMAIL) - 1)), 1, LEN(UPPER(SUBSTRING(cte_tir.CREATEDBY_EMAIL, 1, CHARINDEX('@', cte_tir.CREATEDBY_EMAIL) - 1))) - 1)) 
		
IF OBJECT_ID('tempdb..#TempVendor1') IS NOT NULL
BEGIN
    DROP TABLE #TempVendor1;
END

SELECT 
    ticket_id,
    Folder AS ServiceArea
	INTO #TempVendor1
	FROM (

SELECT 
    aud.ticket_id,
    CASE 
        WHEN aud.SHORT_DESCRIPTION = 'Put in Folder' THEN 
            CASE 
                WHEN CHARINDEX('in ', aud.LONG_DESCRIPTION) > 0 
                    AND CHARINDEX('by ', aud.LONG_DESCRIPTION, CHARINDEX('in ', aud.LONG_DESCRIPTION) + 3) > 0 THEN 
                    SUBSTRING(
                        SUBSTRING(aud.LONG_DESCRIPTION, CHARINDEX('in ', aud.LONG_DESCRIPTION) + 3, LEN(aud.LONG_DESCRIPTION)),
                        1,
                        CHARINDEX('by ', SUBSTRING(aud.LONG_DESCRIPTION, CHARINDEX('in ', aud.LONG_DESCRIPTION) + 3, LEN(aud.LONG_DESCRIPTION))) - 2
                    ) 
                ELSE NULL
            END
        ELSE 
            CASE 
                WHEN CHARINDEX('to ', aud.LONG_DESCRIPTION) > 0 
                    AND CHARINDEX('by ', aud.LONG_DESCRIPTION, CHARINDEX('to ', aud.LONG_DESCRIPTION) + 3) > 0 THEN 
                    SUBSTRING(
                        SUBSTRING(aud.LONG_DESCRIPTION, CHARINDEX('to ', aud.LONG_DESCRIPTION) + 3, LEN(aud.LONG_DESCRIPTION)),
                        1,
                        CHARINDEX('by ', SUBSTRING(aud.LONG_DESCRIPTION, CHARINDEX('to ', aud.LONG_DESCRIPTION) + 3, LEN(aud.LONG_DESCRIPTION))) - 2
                    ) 
                ELSE NULL
            END
    END AS Folder

FROM dbo.UTILISPHERE_TICKET_AUDIT_T aud
INNER JOIN (
    SELECT ticket_id, MAX(TICKET_AUDIT_ID) AS TICKET_AUDIT_ID
    FROM dbo.UTILISPHERE_TICKET_AUDIT_T
    WHERE short_description IN ('put in folder', 'moved to folder')
    GROUP BY ticket_id
) lastfolder_r ON lastfolder_r.ticket_audit_id = aud.ticket_audit_id AND lastfolder_r.TICKET_ID = AUD.TICKET_ID
) a


