      /*^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
	                   CODE For Green PM (SDP)
	  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^*/
	  MERGE
	      dbo.xref_order_assignees AS xr
		  USING (
				 SELECT DISTINCT
	                 kmd.[srvc order unit]
				   , kmd.[installed dt]
				   , od.core_sales_order_id
				   , cods.cods_pm_login as cods_pm_login -- removed kmd.pm_login and coalesce function as per INC4679031
	             FROM
	                 dbo.k_mart_data_daily		kmd
						left outer join dbo.ctl_sdp_to_core_xref	xr
							on kmd.[srvc order unit]	= xr.serv_order_nbr
						left outer join dbo.order_details			od
							on kmd.[srvc order unit]	= od.primary_order_item 
						left outer join (
							select primary_order_item, cods_pm_login from (
								SELECT 
									  od.primary_order_item
									, gal.nt_login cods_pm_login
									, ROW_NUMBER() OVER (PARTITION BY od.primary_order_item ORDER BY CASE WHEN source_role_source_system = 'LIMS' THEN 1 WHEN source_role_source_system = 'SDP' THEN 2 END, oc.date_loaded desc, oc.source_contact_ods_id desc)  row_num
								FROM
									  dbo.order_details od
									, cods.order_contacts oc			 --- cods
									, dbo.GALCapture gal
								WHERE
									    od.source_system = 'SDP'
									AND od.primary_order_item = oc.sou
									AND oc.derived_role_Name LIKE '%Proj%Mgr%'
									AND oc.source_contact_status_cd = 'Active'
									AND (upper(oc.source_contact_email) like '%CENTURYLINK.COM%' or upper(oc.source_contact_email) like '%LUMEN.COM%')
									AND oc.employee_ods_id is not null
									AND oc.employee_ods_id = gal.employee_ods_id
								) z 
							where row_num = 1 ) cods
							on kmd.[srvc order unit]	= cods.primary_order_item 
	             WHERE
	                 kmd.[data src cd]			= 'SDP'  
					 					 ) as src
			 ON xr.[srvc order unit] = src.[srvc order unit]
			WHEN MATCHED AND isNull(xr.pm_ntlogin,'x') <> isNull(src.cods_pm_login,'x') 
				 AND 
				 ( 
				  (
				   core_sales_order_id is not null
				   and ( [installed dt] is null 
						 or [installed dt] >= DATEADD(month, DATEDIFF(month, 0, getdate()), 0) 
						 or core_sales_order_id in ('180610154','181380619')  -- BIRA 7243 Special fix for older installed orders
						 )
				  )
				 )
				THEN UPDATE SET xr.pm_ntlogin = src.cods_pm_login
			WHEN NOT MATCHED AND src.cods_pm_login IS NOT NULL 
				 AND 
				  (
				   core_sales_order_id is not null
				   and ( [installed dt] is null or [installed dt] >= DATEADD(month, DATEDIFF(month, 0, getdate()), 0) )
				  )
			    THEN 
			    INSERT ([srvc order unit],data_src_cd,pm_ntlogin) VALUES (src.[srvc order unit],'SDP',src.cods_pm_login);


	  --------------------------------------------------------
	  -- Inserting PMs that are CCM's witha  PM role
	  --------------------------------------------------------
	  MERGE
	      dbo.xref_order_assignees AS xr
		  USING (SELECT 
                     kmd.[srvc order unit]
				   , gc.nt_login pm_login
				 FROM
				     dbo.k_mart_data_daily kmd  
	                 LEFT OUTER JOIN
	                    dbo.xref_order_assignees xoa
		                   ON kmd.[srvc order unit] = xoa.[srvc order unit]
			                  AND xoa.pm_ntlogin IS NULL
                    INNER JOIN
	                   dbo.galCapture gc
		                 ON kmd.ccm_login = gc.nt_Login
				WHERE
					kmd.[data src cd] = 'SDP'
					AND gc.job_title LIKE '%Project%Manag%'
					AND gc.employee_status = 'Active'
					AND xoa.pm_ntlogin IS NULL) as src
			 ON xr.[srvc order unit] = src.[srvc order unit]
			WHEN MATCHED AND isNull(xr.pm_ntlogin,'x') <> isNull(src.pm_login,'x') AND xr.pm_ntlogin IS NULL THEN 
			    UPDATE SET xr.pm_ntlogin = src.pm_login
			WHEN NOT MATCHED AND src.pm_login IS NOT NULL THEN 
			    INSERT ([srvc order unit],data_src_cd,pm_ntlogin) VALUES (src.[srvc order unit],'SDP',src.pm_login);

