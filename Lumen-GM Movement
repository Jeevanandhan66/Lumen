# Create output folder
$OutputFolder = ".\MyJobs"
New-Item -ItemType Directory -Force -Path $OutputFolder | Out-Null

# Get logged-in user
$Me = (databricks current-user me --output json | ConvertFrom-Json).user_name

# Get all jobs
$Jobs = databricks jobs list --output json | ConvertFrom-Json

foreach ($Job in $Jobs) {

    if ($Job.creator_user_name -eq $Me) {

        $JobId = $Job.job_id
        $JobName = $Job.settings.name

        # Replace invalid filename characters
        $SafeName = $JobName -replace '[\\/:*?"<>|]', '_'

        Write-Host "Exporting $SafeName..."

        databricks jobs get $JobId --output json |
            Out-File "$OutputFolder\$SafeName.json" -Encoding utf8
    }
}

Write-Host "Completed! All your jobs have been exported to $OutputFolder"
