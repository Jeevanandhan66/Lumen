                        'LI-CT01', 'LI-CT02', 'LI-CT03', 'LI-NY01', 'LI-NYC01', 'MIA468', 'MIA583', 'MN01', 'MN02', 'MN03', 'MN05', 'MN06', 
                        'MN07', 'MN08', 'MN09', 'NFL14', 'NJ01', 'NO04', 'NO11', 'NVL01', 'NVL03', 'NVL04', 'NVL06', 'NVL09', 'NVL12', 
