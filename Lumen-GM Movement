	,task_name
	,task_status
	,task_start_time
	,task_end_time
	,task_due_date
	,performer_name
	,work_site_location
	,task_id
	,task_due_status
	,gfs_market
	,gfs_division
	,gfs_region
	,jeop_owner
	,open_constraints
	,constraint_omc_sous
	,constraint_types
	,constraint_buildsystems
	,constraint_buildsystemids
	,open_const_count
	,const_max_latest_dcd
	,jeopardy_reason_cd
	,short_description
	,raised_by_performer_name
	,jeopardy_raised_dt
	,jeopardy_resolution_dt
	,resolved_by_performer_name
