IF OBJECT_ID('tempdb..#const') IS NOT NULL
	DROP TABLE #const;

SELECT DISTINCT w.srvc_order_unit
	,ji.ownernt AS Jeop_owner
	,jc.constraintid
	,w.OMC_SOU
	,CASE 
		WHEN b.friendly_id IS NOT NULL
			THEN b.masterclassgroup
		ELSE jc.constrainttype
		END AS constraint_type
	,CASE 
		WHEN b.friendly_id IS NOT NULL
			THEN b.mastermadate
		ELSE jc.dateclosed
		END AS closed_dt
	,jc.buildsystem
	,jc.buildsystemid AS constraint_buildsystemid
	,CASE 
		WHEN b.friendly_id IS NOT NULL
			THEN isnull(b.dcd, b.rdcd)
		ELSE isnull(jc.dcd, jc.rdcd)
		END AS latest_dcd_ncd
INTO #const
FROM #sou_limit w
INNER JOIN (
	SELECT DISTINCT [srvc order unit]
		,constraintid
		,buildsystemid
	FROM [tbl_nasd_const2sous] WITH (NOLOCK)
	) c ON w.srvc_order_unit = c.[srvc order unit]
LEFT OUTER JOIN pnd.dbo.thenetbuildordercube b WITH (NOLOCK) ON c.buildsystemid = b.FRIENDLY_ID
LEFT OUTER JOIN [dbo].[Tbl_Storm_jeopconstraints] jc WITH (NOLOCK) ON c.constraintid = jc.constraintid
LEFT OUTER JOIN [dbo].[tbl_Storm_jeopinfo] ji WITH (NOLOCK) ON jc.jeopid = ji.jeopid;

IF OBJECT_ID('tempdb..#const_concat') IS NOT NULL
	DROP TABLE #const_concat;

SELECT t1.srvc_order_unit
	,STUFF((
			SELECT ', ' + cast(t2.constraintID AS VARCHAR(16))
			FROM #const t2
			WHERE t2.srvc_order_unit = t1.srvc_order_unit
				AND t2.closed_dt IS NULL
			ORDER BY t2.constraintID
			FOR XML PATH('')
				,TYPE
			).value('.', 'varchar(max)'), 1, 2, '') AS Open_Constraints
	,STUFF((
			SELECT ', ' + t2.Jeop_owner
			FROM #const t2
			WHERE t2.srvc_order_unit = t1.srvc_order_unit
				AND t2.closed_dt IS NULL
			ORDER BY t2.constraintID
			FOR XML PATH('')
				,TYPE
			).value('.', 'varchar(max)'), 1, 2, '') AS Open_Constraint_Jeop_Owner
	,STUFF((
			SELECT ', ' + t2.constraint_type
			FROM #const t2
			WHERE t2.srvc_order_unit = t1.srvc_order_unit
				AND t2.closed_dt IS NULL
			ORDER BY t2.constraintID
			FOR XML PATH('')
				,TYPE
			).value('.', 'varchar(max)'), 1, 2, '') AS Open_constraint_type
	,STUFF((
			SELECT ', ' + t2.buildsystem
			FROM #const t2
			WHERE t2.srvc_order_unit = t1.srvc_order_unit
				AND t2.closed_dt IS NULL
			ORDER BY t2.constraintID
			FOR XML PATH('')
				,TYPE
			).value('.', 'varchar(max)'), 1, 2, '') AS Open_Const_buildsystem
	,STUFF((
			SELECT ', ' + t2.constraint_buildsystemid
			FROM #const t2
			WHERE t2.srvc_order_unit = t1.srvc_order_unit
				AND t2.closed_dt IS NULL
			ORDER BY t2.constraintID
			FOR XML PATH('')
				,TYPE
			).value('.', 'varchar(max)'), 1, 2, '') AS Open_constraint_buildsystemid
	,STUFF((
			SELECT ', ' + convert(VARCHAR(16), t2.latest_dcd_ncd, 101)
			FROM #const t2
			WHERE t2.srvc_order_unit = t1.srvc_order_unit
				AND t2.closed_dt IS NULL
			ORDER BY t2.constraintID
			FOR XML PATH('')
				,TYPE
			).value('.', 'varchar(max)'), 1, 2, '') AS Open_Constraint_latest_ncd
	,STUFF((
			SELECT ', ' + t2.omc_sou
			FROM #const t2
			WHERE t2.srvc_order_unit = t1.srvc_order_unit
				AND t2.closed_dt IS NULL
			ORDER BY t2.constraintID
			FOR XML PATH('')
				,TYPE
			).value('.', 'varchar(max)'), 1, 2, '') AS Constraint_OMC_SOUs
	,sum(CASE 
			WHEN t1.closed_dt IS NULL
				THEN 1
			ELSE 0
			END) AS Open_Const_Count
INTO #const_concat
FROM #const t1
GROUP BY t1.srvc_order_unit;

