ALTER PROCEDURE [dbo].[usp_xref_order_assignees]  @iAgentJob VARCHAR(1000) = NULL

--FOR TESTING: EXEC [dbo].[usp_xref_order_assignees]
	
AS
BEGIN

SET NOCOUNT ON;

      --Declare a variable to handle the agent job NULL and apply the host name running if manual
	DECLARE @vAgentJob		VARCHAR(1000) = isNull(@iAgentJob,'Manual Run ('+HOST_NAME()+')');
	DECLARE @vProcessName VARCHAR(100) = 'xref_order_assignees';

	BEGIN TRY
	--------------------------------------------------------
	-- Job Validation start / dependencies
	--------------------------------------------------------
    EXEC dbo.sp_jv_update @reportName		= @vProcessName
						, @updatetype		= 0
						, @source_server	= @@SERVERNAME
						, @source_job		= @vAgentJob;

	
	
	-- Force EON prov assignment based on task level data if no assignment was made in OMC
	-- Create temp physical table for raw EON data
	if OBJECT_ID('tempdb..#tmp_eon_assignment') is null
		create table #tmp_eon_assignment
			(order_item varchar(128)
			,user_id varchar(64)
			,nt_login varchar(128)
			,activity_name varchar(128)
			,completion_date datetime
			,pri_task_idx int
			,assignment_type varchar(4)
			,id int identity(1,1)
			)
		;
	else
		truncate table #tmp_eon_assignment
		;
	;

	-- quick fix for employee who's nt login has changed. 
/*	UPDATE dbo.tbl_storm_orderassignees 
	set AssignedToNT = 'champion.karen' 
	where ASSIGNEDTOPERSONID = 192077 
*/

	-- Gather EON assignments based on the tasks listed. Used row_number() instead of min/maxing due to trump logic
	insert into #tmp_eon_assignment
	select
		 *
		,'Prov' as assignment_type
	from
		(select 
			 z.order_item
			,z.user_id
			,z.nt_login
			,z.activity_name
			,z.completion_date
			,ROW_NUMBER() over (partition by z.order_item order by z.task_trump, z.completion_date desc) as pri_task_idx
		from
			(select
				 a.activity_status_group
				,a.action_type
				,a.completion_date
				,a.order_item
				,a.user_id
				,a.user_name
				,b.nt_login
				,a.activity_name
				,a.group_name
				,case when	a.activity_name in ('Design POP-to-POP','Fix Order: Design POP-to-POP') then 0 else 99 end as task_trump
			from dbo.tbl_task_durations a
			inner join dbo.vw_last_employee_instance b on a.user_id = b.gc_userid
			where a.activity_name in ('Fix Order: Design POP-to-POP','Design POP-to-POP','Move Path Below DS3','Move Path','Fix Order: Move Path Below DS3','Fix Order: Move Path')
				and a.order_item is not null
				and a.completion_date between dateadd(month,-1,dbo.trunc(getdate())) and GETDATE()
			) z
		) y
	where	y.pri_task_idx = 1
	;
	
	insert into dbo.xref_order_assignees
		([Srvc Order Unit]
		,OMC_SOU
		,Provisioner
		,data_src_cd
		)
	select
		 a.order_item
		,b.OMC_SOU
		,a.nt_login
		,'GC_EON'
	from #tmp_eon_assignment a
	left outer join dbo.rosetta_stone b on a.order_item = b.SA_Mart_SOU
	left outer join dbo.xref_order_assignees c on a.order_item = c.[Srvc Order Unit]
	where c.id is null
	;

	insert into xref_order_assignees 
		([Srvc Order Unit]
		,order_number
		,OMC_SOU
		,data_src_cd
		)
	select
		 t.*
	from
		(select 
			 po.[srvc order unit]
			,po.[order number]
			,r.omc_sou
			,po.[data src cd]			
		from dbo.k_mart_data_daily po with (nolock)
		left outer join rosetta_stone r with (nolock) on po.[srvc order unit] = r.sa_mart_sou and po.[order number] = r.[order number]
		where po.pending_installed_ind = 1
			or	po.installed_complete_ind = 1
			and isd_month >= dbo.fn_DisplayMonth(dateadd(month,-3,getdate()))
		) t 
		left outer join xref_order_assignees oa with (nolock) on t.[srvc order unit] = oa.[srvc order unit]
	where oa.[srvc order unit] is null
	;
	                      
	--catch null omc sous 
	update	a
	set omc_sou = b.OMC_SOU
	from dbo.xref_order_assignees a
	inner join dbo.rosetta_stone b on a.[Srvc Order Unit] = b.SA_Mart_SOU
	where a.omc_sou is null
	;
	
	-- [Abdul Baseer 2017-04-08	- Added below query to fix order number mismatch for pipeline supp orders]
	UPDATE X
	set 
		OMC_SOU					= r.omc_sou,
		order_number			= k.[order number],
		Provisioner				= NULL,
		Tester					= NULL,
		CCM						= NULL,
		VoiceProvisioner		= NULL,
		OffNetProvisioner		= NULL,
		offnetprov_nt			= NULL,
		offnet_escalation_mgr	= NULL,
		pm_ntlogin				= NULL,
		om_ntlogin				= NULL
	from xref_order_assignees X 
	inner join k_mart_data_daily K on K.[srvc order unit] = X.[Srvc Order Unit] 
	left outer join rosetta_stone r with (nolock) on k.[srvc order unit] = r.sa_mart_sou and k.[order number] = r.[order number]
	where K.[data src cd] = 'Pipeline' 
	and [order type] = 'Supp'
	and k.[order number] <> X.order_number
	and [ord status] = 'Pending'
	
	--update	                      
	update po
	set	po.Provisioner = isnull(sp.prov_loginid ,prov2.nt_login)
	from dbo.xref_order_assignees po with (nolock)
	left outer join dbo.tbl_storm_orderprovisioner sp with (nolock) on po.omc_sou = sp.srvc_order_unit
	left outer join dbo.tbl_storm_orders so with (nolock) on po.omc_sou = so.srvc_order_unit and po.order_number = so.ORDER_NUMBER
	left outer join dbo.galcapture prov2 with (nolock) on cast(so.provisioner_id as varchar(25)) = prov2.person_id 
	where (po.Provisioner is null or po.Provisioner <> isnull(sp.prov_loginid ,prov2.nt_login))
		and (sp.prov_loginid is not null or	prov2.NT_LOGIN is not null)
	;

	update po   
	set	po.Tester = isnull(tnt2.assignedtont, tnt.nt_login)
	from dbo.xref_order_assignees po with (nolock)
	left outer join dbo.tbl_storm_orders so with (nolock) on po.omc_sou = so.srvc_order_unit and po.order_number = so.ORDER_NUMBER
	left outer join dbo.galcapture tnt with (nolock) on so.tnt_person_id = tnt.person_id
	left outer join
		(select
			x.OMC_SOU as srvc_order_unit
			,x.AssignedToNT
		from
			(select
				z.*
				,isnull(y.OMC_SOU,z.srvc_order_unit) as omc_sou
				,row_number() over (partition by isnull(y.OMC_SOU,z.srvc_order_unit) order by z.ts desc) as idx
			from
				(select
					guid
					,srvc_order_unit
					,case when soa2.srvc_order_unit like '100%-%' then substring(soa2.srvc_order_unit,1,patindex('%-%',soa2.srvc_order_unit)-1) else soa2.srvc_order_unit end as adj_sou
					,assignedbynt
					,assignedtont
					,assignedtopersonid
					,persontypecode
					,ts
				from dbo.tbl_storm_orderassignees soa2 with (nolock)
				where persontypecode = 'tnt'
						and soa2.ts >= dbo.trunc(dateadd(day,-7,getdate()))
				) z
			left outer join dbo.rosetta_stone y on z.adj_sou = y.SA_Mart_SOU
			) x
		where	x.idx = 1
		) tnt2 on po.omc_sou = tnt2.srvc_order_unit
	where (po.Tester is null or	po.Tester <> isnull(tnt2.assignedtont, tnt.nt_login))
		and (tnt2.AssignedToNT is not null or tnt.NT_LOGIN is not null)
	;


	/********************************************************************************************
	Stage CCM data from OMC with all possible combos of logins already staged.  Will be used
	multiple times to join based on the SOU or the PIID.  Staging to reduce overhead of the
	query.
	********************************************************************************************/


	--BIRA 6836 for the 2 patches here for dbo.tbl_storm_orderassignees and dbo.tbl_storm_orders
	--          There was a mapping fix done on a go-forward basis in OMC Production Mid April 2020 per Deovrat for CCM assignments.
	--          But there wasn't an update done to current records in StormRT assigned to the wrong James Johnson
	Update a
	SET assignedtont = 'JOHNSON.JAMES',
		assignedtopersonid = '204600'
	FROM dbo.tbl_storm_orderassignees a
	WHERE AssignedToPersonID = '99297506'

	--Same as Above.  This is the Storm_Orders Fix for BIRA 6836
	Update a
	SET cpm_full_nm = 'Johnson, James (James)',
		cpm_person_id = '204600'  --The CCM James Johnson
	FROM tbl_storm_orders a
	WHERE cpm_person_id = '99297506'  --The NON-CCM James Johnson - 964 to Change over

	update po
	set	po.voiceprovisioner = isnull(v2.assignedtont,voice.nt_login)
	from dbo.xref_order_assignees po with (nolock)
	left outer join dbo.tbl_storm_orders so with (nolock) on po.omc_sou = so.srvc_order_unit and po.order_number = so.ORDER_NUMBER
	left outer join
		(select
			srvc_order_unit
			,assignedtont
		from dbo.tbl_storm_orderassignees as soa with (nolock)
		where persontypecode = 'voice'
		) v2 on po.omc_sou = v2.srvc_order_unit
	left outer join dbo.galcapture voice with (nolock) on so.voice_provisioner_id = voice.person_id 
	where (v2.assignedtont is not null or voice.nt_login is not null)
		and (po.VoiceProvisioner is null or	po.VoiceProvisioner <> isnull(v2.assignedtont,voice.nt_login))
	;

	update po
	set	po.OffNetProvisioner = a.asr_rep
	from dbo.xref_order_assignees po
	inner join
		(select
			z.SRVC_ORDER_UNIT
			,z.ORDER_NUMBER
			,max(asr_rep) as asr_rep
		from dbo.tbl_storm_asrs z with (nolock)
		where	z.ASR_REP is not null
		group by z.SRVC_ORDER_UNIT,z.ORDER_NUMBER
		) a	on po.[Srvc Order Unit] = a.SRVC_ORDER_UNIT and po.order_number = a.ORDER_NUMBER
	where po.OffNetProvisioner is null or po.OffNetProvisioner <> a.asr_rep
	;

	update a
	set	OffNetProvisioner = c.full_name
	from dbo.xref_order_assignees a with (nolock)
	inner join dbo.tbl_Storm_OrderAssignees b with (nolock) on	a.OMC_SOU = b.srvc_order_unit and b.PersonTypeCode = 'ONETPROV'
	inner join dbo.galcapture c with (nolock) on b.AssignedToNT = c.NT_LOGIN
	where a.data_src_cd not in ('SWIFT','SWIFT (BPM)')
	;
	--Join with related order items table to have the offnet provisioner for the SWIFT/SWIFT (BPM) orders
	update a
	set	OffNetProvisioner = c.full_name
	from dbo.xref_order_assignees a with (nolock)
	inner join related_order_items r on a.[Srvc Order Unit] = replace(r.primary_order_item,'-','/')
    inner join Tbl_Storm_OrderAssignees b on replace(r.order_item,'-','/')= b.srvc_order_unit
	inner join dbo.galcapture c with (nolock) on b.AssignedToNT = c.NT_LOGIN
	where isnull(r.data_source_location,'Keep') <> 'Derived_DSL_SD'
    and r.source_system in ('SWIFT','SWIFT (BPM)')
    and 1=case when r.product_name like '%Access - Off Net%' and b.PersonTypeCode = 'ONETPROV' then 1
	when b.PersonTypeCode = 'ONETPROV' then 1 else 0 end
	;

	update a
	set offnetprov_nt = b.NT_LOGIN
	from dbo.xref_order_assignees a with (nolock)
	inner join dbo.GALCapture b with (nolock) on a.OffNetProvisioner = b.FULL_NAME
	where a.OffNetProvisioner is not null
	;

	update a
	set offnet_escalation_mgr = b.AssignedToNT
	from dbo.xref_order_assignees a with (nolock)
	inner join dbo.Tbl_Storm_OrderAssignees b with (nolock) on a.OMC_SOU = b.srvc_order_unit and b.PersonTypeCode = 'VendorEscalationManager'
	;
					
	update a
	set	a.pm_ntlogin = b.AssignedToNT
	from dbo.xref_order_assignees a with (nolock)
	inner join dbo.tbl_Storm_OrderAssignees b with (nolock) on a.OMC_SOU = b.srvc_order_unit and b.PersonTypeCode = 'pm'
	;

	update a
	set	a.om_ntlogin = b.AssignedToNT
	from dbo.xref_order_assignees a with (nolock)
	inner join dbo.tbl_Storm_OrderAssignees b with (nolock) on a.OMC_SOU = b.srvc_order_unit and b.PersonTypeCode = 'om'
	;

	delete from dbo.xref_order_assignees
	where id in	(select 
					id
				from
					(select 
						 a.*
						, ROW_NUMBER() over (partition by a.[srvc order unit] order by id desc) as souidx
					from xref_order_assignees a
					) a
				where a.souidx > 1
				)
	;   
	
	
	-----------------------------------------------------------------------------------------------
	--  Clean up any logins from OMC that do not match NT login but CUID or Universal Id
	-----------------------------------------------------------------------------------------------               
	-------------
	-- CCM not needed as done in the above CCM code directly
	-------------	

	----------------
	-- Provisioner 
	----------------
	UPDATE 
        xref 
    SET
        Provisioner = xcuid.nt_login
    FROM 
        dbo.xref_order_assignees xref 
	        INNER JOIN 
		        (SELECT DISTINCT 
                     xoa.provisioner
                   , gcCUID.nt_login
                 FROM
                     dbo.xref_order_assignees xoa
                         LEFT OUTER JOIN
		                     dbo.galCapture gcCheck 
			                     ON xoa.provisioner = gcCheck.nt_login 
		                 INNER JOIN
    		                 dbo.galCapture gcCUID
			                     ON xoa.provisioner = gcCUID.cuid
                 WHERE
                    gcCheck.nt_login IS NULL) xcuid
        ON xref.provisioner = xcuid.provisioner
	WHERE xcuid.nt_login is not null --ONLY update if a non-null result is returned
	;

	--3-6-2019: Phil Ferlin: For DIA Products OMC stores the Provisioner in StormOrderProvisioner with order_number + '/' + pcid
	Update a
	SET provisioner = prov_loginid
	FROM
	  dbo.xref_order_assignees a inner join
	  (
		SELECT
		  dd.[sa recvd dt], dd.[srvc order unit], dd.[data src cd], dd.[prod type],
		  so.order_number + '/' + so.pcid AS assignment_sou, 
		  op.prov_loginid,
		  gc1.full_name as Provisioner
		FROM
		  dbo.k_mart_data_daily dd inner join
		  dbo.tbl_storm_orders so ON dd.[srvc order unit] = so.srvc_order_unit inner join
		  dbo.stg_Storm_OrderProvisioner op ON so.order_number + '/' + so.pcid = op.srvc_order_unit inner join
		  dbo.galcapture gc1 ON op.prov_loginid = gc1.nt_login
	  ) b ON a.[srvc order unit] = b.[srvc order unit]
	WHERE
	  a.provisioner is null

--Pass #2 using child products of DIA that are parent SOU's
--TESTING
--select
--scp.SRVC_ORDER_UNIT, scp.SRVC_ORDER_UNIT_PIID, scp.prov_child_product, parent_child_ind, op.srvc_order_unit, 
--op.prov_full_nm, op.prov_loginID, xoa.[srvc order unit], xoa.provisioner
Update xoa
Set provisioner = op.prov_loginID
from
dbo.tbl_STORM_SWIFT_CHILD_PRODUCTS scp inner join
dbo.tbl_storm_orderprovisioner op on scp.SRVC_ORDER_UNIT_PIID = op.srvc_order_unit inner join
dbo.xref_order_assignees xoa on scp.SRVC_ORDER_UNIT = xoa.[srvc order unit]
where
--scp.SRVC_ORDER_UNIT In ('551717161/442595663', '551930175/443158547', '551870975/442825792', '551857334/442976202')
--and
----prov_child_product = 'Dedicated Internet Access'
parent_child_ind = 'P'
and 
(xoa.provisioner is null or IsNull(xoa.provisioner,'None') <> IsNull(op.prov_loginID, 'Null'))


    ----------------
	-- Tester 
	----------------
	UPDATE 
        xref 
    SET
        tester = xcuid.nt_login
    FROM 
        dbo.xref_order_assignees xref 
	        INNER JOIN 
		        (SELECT DISTINCT 
                     xoa.tester
                   , gcCUID.nt_login
                 FROM
                     dbo.xref_order_assignees xoa
                         LEFT OUTER JOIN
		                     dbo.galCapture gcCheck 
			                     ON xoa.tester = gcCheck.nt_login 
		                 INNER JOIN
    		                 dbo.galCapture gcCUID
			                     ON xoa.tester = gcCUID.cuid
                 WHERE
                    gcCheck.nt_login IS NULL) xcuid
        ON xref.tester = xcuid.tester
		WHERE xcuid.nt_login is not null --ONLY update if a non-null result is returned;
	
	--3-6-2019: Phil Ferlin: For DIA Products OMC stores the Tester in Tbl_Storm_OrderAssignees with order_number + '/' + pcid
	Update a
	SET tester = assignedtont
	FROM
	  dbo.xref_order_assignees a inner join
	  (
		SELECT
		  dd.[sa recvd dt], dd.[srvc order unit], dd.[data src cd], dd.[prod type],
		  so.order_number + '/' + so.pcid as assignment_sou,
		  oa.assignedtont,
		  gc.full_name AS Tester
		FROM
		  dbo.k_mart_data_daily dd inner join
		  dbo.tbl_storm_orders so on dd.[srvc order unit] = so.srvc_order_unit inner join
		  (SELECT * FROM Tbl_Storm_OrderAssignees WHERE persontypecode = 'TNT') oa ON so.order_number + '/' + so.pcid = oa.srvc_order_unit inner join
		  dbo.galcapture gc ON oa.assignedtont = gc.nt_login 
	  ) b ON a.[srvc order unit] = b.[srvc order unit]
	WHERE
	  a.tester is null

    ----------------
	-- Voice Provisioner 
	----------------
	UPDATE 
        xref 
    SET
