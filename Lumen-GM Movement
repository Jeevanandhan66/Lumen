IF OBJECT_ID('tempdb..#offnet_tsk') IS NOT NULL
	DROP TABLE #offnet_tsk;

SELECT DISTINCT b.*
	,isnull(g1.dept_name, b.task_assignee) AS Dept
	,isnull(g1.job_title, b.task_assignee) AS title
	,isnull(g1.supervisor_name, b.task_assignee) AS Mgr
INTO #offnet_tsk
FROM (
	SELECT a.*
		,row_number() OVER (
			PARTITION BY primary_order_item
			,task_name ORDER BY task_end_date DESC
			) AS rownum
	FROM (
		SELECT DISTINCT w.primary_order_item
			,w.task_order_item
			,w.source
			,w.sales_region
			,w.operating_region_cd
			,CASE 
				WHEN w.source = 'hybrid'
					THEN 'Hybrid: ' + tsk.task_name
				WHEN w.source LIKE 'related order%'
					THEN 'Related: ' + tsk.task_name
				ELSE tsk.task_name
				END AS task_name
			,tsk.task_assignee
			,tsk.task_end_date
			,tsk.task_due_date
			,tsk.task_id
			,tsk.task_source
			,CASE 
				WHEN tsk.cods_task_status = 'COMPLETE'
					OR tsk.task_derived_status = 'Completed'
					THEN 1
				ELSE 0
				END AS offnet_task_status
		FROM task_details tsk WITH (NOLOCK)
		INNER JOIN #tsk_join_prep w ON w.task_order_item = tsk.task_sou
		WHERE w.source_system NOT IN (
				'eon'
				,'gc_eon'
				,'global crossing'
				,'level 3'
				,'siebel'
				,'pipeline'
				,'red'
				,'reverse direct de'
				)
			AND (
				tsk.task_start_date IS NOT NULL
				OR tsk.task_assignee IS NOT NULL
				)
			AND tsk.task_name IN (
				'offnet_create_and_send_order'
				,'offnet_receive_complete'
				,'offnet_fe_receive_foc'
				)
		
		UNION
		
		SELECT w.primary_order_item
			,w.task_order_item
			,w.source
			,w.sales_region
			,w.operating_region_cd
			,CASE 
				WHEN w.source = 'hyb'
					THEN 'Hybrid: ' + tsk.task_name
				WHEN w.source LIKE 'related order%'
					THEN 'Related: ' + tsk.task_name
				ELSE tsk.task_name
				END AS task_name
			,tsk.performer_name
			,CASE 
				WHEN tsk.task_status = 'completed'
					THEN tsk.task_end_time
				ELSE NULL
				END AS task_end_time
			,tsk.task_end_time
			,NULL AS task_id
			,'tbl_workflow_tasks' AS tsk_src
			,CASE 
				WHEN task_status = 'completed'
					THEN 1
				ELSE 0
				END AS offnet_task_status
		FROM tbl_workflow_tasks tsk WITH (NOLOCK)
		INNER JOIN #tsk_join_prep w ON w.task_order_item = tsk.srvc_order_unit
		
		WHERE tsk.bpm_process_type = 'OFFNET'
			AND tsk.task_name IN (
				'CreateASR'
				,'InitiateASRManual'
				,'InitiateASR'
				,'CaptureFOC'
				,'FOCNotification'
				,'Follow Up'
				)
		) a
	) b
LEFT OUTER JOIN galcapture g1 ON b.task_assignee = g1.nt_login
WHERE rownum = 1;

