	,provisioner
	,prov_mgr
	,mrr
	,product_family_name
	,orig_cust_commit_dt_rpt
	,cust_commit_dt
	,completed_dt
	,report_date
	,sales_region
	,operating_region
	,bu_short
	,bu_segment)

	select DISTINCT
	d.srvc_order_unit as srvc_order_unit
	,d.omc_sou
	,d.functional_group
	,d.ccmmngr
	,lower(d.provmngr) as provmngr
	,lower(d.tester) as tester
	,d.business_org_name
	,d.cust_req_dt
	,d.bandwidth as bandwidth_grp
	,case when v.acity is null then k.aclli else v.acity end as acity
	,case when v.ast is null then 'SWIFT' else v.ast end as ast
	,case when v.zcity is null then k.zclli else v.zcity end as zcity
	,case when v.zst is null then 'SWIFT' else v.zst end as zst
	,d.last_brief_note
	,d.task_name
	,d.task_status
	,d.task_start_time
	,d.task_end_time
	,d.task_due_date
	,d.task_assignee as performer_name
	,d.work_site_location
	,d.task_id
	,case 
		when dbo.trunc(d.task_end_time) is not null and dbo.trunc(d.task_due_date) is not null
			and dbo.trunc(d.task_end_time) <= dbo.trunc(d.task_due_date) 
				then 'Due Date MET'
		when dbo.trunc(d.task_end_time) is not null and dbo.trunc(d.task_due_date) is not null
			and dbo.trunc(d.task_end_time) > dbo.trunc(d.task_due_date) 
				then 'Due Date MISSED'
		when dbo.trunc(d.task_end_time) is null and dbo.trunc(k.[completed dt]) is not null and dbo.trunc(d.task_due_date) is not null
				THEN 'Task End Date MISSING'
		when dbo.trunc(isnull(d.task_due_date, d.task_end_time)) < @p_hist_dt 
				then 'Past Due'
		when dbo.trunc(isnull(d.task_due_date, d.task_end_time)) = @p_hist_dt 
				then 'Due Today'
		when dbo.trunc(isnull(d.task_due_date, d.task_end_time)) > @p_hist_dt 
				then 'Due Later'
		else 'Verify Due Date'
		end as task_due_status
	,d.market as gfs_market
	,d.division as gfs_division
	,d.region as gfs_region
	,d.open_constraint_jeop_owner as jeop_owner
	,d.open_constraints
	,d.constraint_omc_sous
	,d.open_constraint_type as constraint_types
	,d.open_const_buildsystem as constraint_buildsystems
	,d.open_constraint_buildsystemid as constraint_buildsystemids
	,d.open_const_count
	,d.open_constraint_latest_ncd as const_max_latest_dcd
	,d.jeopardy_reason_cd as jeopardy_reason_cd
	,d.short_description as short_description
	,d.raised_by_performer_name as raised_by_performer_name
	,d.jeopardy_raised_dt as jeopardy_raised_dt
	,d.jeopardy_resolution_dt as jeopardy_resolution_dt
	,d.resolved_by_performer_name as resolved_by_performer_name
	,cwn.note_dt as task_note_date
	,replace(replace(replace(cwn.note_text, char(13), ' '), char(10), ' '), char(9), ' ') as task_note_text
	,cwn.user_name as note_user_name
	,cea.cea_dt as cust_early_accept_dt
	,lower(p.prov_loginid) as provisioner
	,lower(p_mgr.prov_mgr) as prov_mgr
	--,CASE WHEN SOU.source_system in ('swift', 'SWIFT (BPM)') THEN p.prov_loginID ELSE lower(p.prov_loginID) END AS provisioner
	--,CASE WHEN SOU.source_system in ('swift', 'SWIFT (BPM)') THEN p.PROV_MGR ELSE lower(p_mgr.PROV_MGR) END AS prov_mgr
	,d.mrr as mrr
	,d.product_family_name as product_family_name
	,d.orig_cust_commit_dt_rpt as orig_cust_commit_dt_rpt
	,d.cust_commit_dt as cust_commit_dt
	,k.[completed dt] as completed_dt
	,@p_hist_dt as report_date
	,d.sales_region
	,d.operating_region_cd as operating_region
	,s.BU_SHORT
	,s.bu_segment
FROM #details d
LEFT OUTER JOIN #offnet_tsk_concat ot ON d.srvc_order_unit = ot.primary_order_item
LEFT OUTER JOIN #CEA cea ON d.srvc_order_unit = cea.order_item
LEFT OUTER JOIN #task_note cwn WITH (NOLOCK) ON d.task_id = cast(cwn.task_id AS VARCHAR(64))
LEFT OUTER JOIN [V_PROV_ORDER_ALL] v WITH (NOLOCK) ON d.srvc_order_unit = v.[SRVC_ORDER_UNIT]
LEFT OUTER JOIN [k_mart_data_daily] k WITH (NOLOCK) ON d.srvc_order_unit = k.[srvc order unit]
LEFT OUTER JOIN [Dbo].[TBL_SFDC_ACCOUNT] s WITH (NOLOCK) ON k.ULTIMATE_CUST_ID=s.Ultimate_Cust_Num
LEFT OUTER JOIN #prov p on p.srvc_order_unit = d.srvc_order_unit
LEFT OUTER JOIN #prov p_mgr on p_mgr.srvc_order_unit = d.srvc_order_unit
--LEFT OUTER JOIN #sou_limit SOU on SOU.srvc_order_unit = p.srvc_order_unit
--LEFT OUTER JOIN tbl_k_mart_daily_w_metasolv_and_latam ml on d.task_sou = ml.[srvc order unit]




