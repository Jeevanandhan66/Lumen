					'ATL01', 'ATL02', 'ATL06', 'ATL11', 'ATL12', 'ATL14', 'ATL18', 'ATL19', 'ATL20', 'ATL21', 'AUS03', 'AUS04', 'AUS07', 'AUS08', 'AUS11', 'AUS12', 'BAL02', 'BAL03', 'BOS02', 'BOS03', 'BOS04', 'BOS05', 'BOS08', 'BOS09', 'BOS11', 'BOS421', 'CAN01', 'CAN02', 'CAN04', 'CAR01', 'CAR02', 'CAR03', 'CAR05', 'CAR06', 'CAR06A', 'CAR07', 'CAR08', 'CAR09', 'CIN01', 'CIN04', 'CIN05', 'CIN06', 'CIN09', 'CWI02', 'DAL02A', 'DAL03', 'DAL03A', 'DAL05', 'DAL06A', 'DAL08', 'DAL09', 'DEN01b', 'DEN03', 'DEN04', 'DEN05', 'DEN06', 'DEN07', 'DEN08', 'DEN09', 'DEN10', 'DEN11', 'DEN13', 'DENMNS03', 'DENMNS05', 'DETD06', 'DETD07', 'DETD08', 'DETD09', 'DETD15', 'DETD16', 'DETD21', 'ELP01', 'ELP02', 'ELP03', 'ELP04', 'ELP05', 'ELP06', 'ELP07', 'ELP08', 'ELP09', 'ELP10', 'GAMNS02', 'GC01', 'GC02', 'GC03', 'GC05', 'GC06', 'HOU02', 'HOU05', 'HOU07', 'HOU08', 'HOU09', 'HOU11', 'HOU15', 'IL01', 'IL02', 'IL03', 'IL04', 'IL07', 'IN03', 'KC01', 'KC03', 'KC05', 'KC06', 'KC09', 'KC13', 'KC14', 'KC15', 'KC16', 'KC17', 'KC18', 'KC19', 'KC20', 'KC21', 'KC22', 'KC25', 'KC26', 'KC27', 'KC29', 'KC30', 'KC31', 'KSMNS01', 'KYMNS01', 
					'KYMNS02', 'LAX01', 'LAX01B', 'LAX02', 'LAX03', 'LAX04', 'LVG02', 'MIA01', 'MIA02', 'MIA03', 'MIA04', 'MIA05', 'MIA468', 'MIA583', 'MIA583 Metro', 'MN04', 'MN11', 'NFL01', 'NFL03', 'NFL14', 'NFL15', 'NFL16', 'NIL01', 'NO01', 'NO03', 'NO05', 'NO06', 'NO07', 'NO08', 'NO09', 'NO12', 'NO15', 'NO16', 'NVL02', 'NVL05', 'NVL07', 'NVL08', 'NVL10', 'NVL11', 'NWI01', 'NWI02', 'ORJ09', 'ORJ10', 'ORJ502', 'ORJ584', 'PA03', 'PAMNS02', 'PAMNS04', 'PAMNS06', 'PAMNS07', 'PAMNS08', 'PHO01', 'PHO02', 'PHO03', 'PHO04', 'PHO06', 'POR08', 'POR09', 'POR10', 'POR11', 'POR16', 'POR23', 'RCH03', 'RCH07', 'RCH10', 'SDG01', 'SDG02', 'SDG03', 'SDG04', 'SDG05', 'SDG06', 'SDG07', 'SDGMNS01', 'SEA02', 'SEA03', 'SEA04', 'SEA05', 'SF01', 'SF02', 'SF03', 'SF04', 'SF05', 'SF06', 'SF07', 'SF08', 'SF09', 'SF10', 'SF11', 'SF12', 'SFL06', 'SFL07', 'SJO01', 'SJO02', 'SJO03', 'SJO04', 'SJO05', 'SJO06', 'SJO07', 'SJO08', 'SJO09', 'SJO10', 'SJO11', 'SJO12', 'SJO13', 'SJO14', 'SJO15', 'SJO16', 'SLC01', 'SLC02', 'SLC03', 'SLC04', 'SLC05', 'SLC08', 'SLC09', 'SLC10', 'SLC11', 'STL04', 'STL06', 'STL10', 'STR01', 'STR02', 'STR03', 
					'STR05', 'SWI01', 'SXF01', 'SXF02', 'SXF03', 'SXF04', 'TNMNS02', 'TPO01', 'TPO03', 'TPO04', 'TPO08', 'Training', 'Unicorn Project 9', 'VA01', 'VA02', 'VA03', 'VA05', 'VA06', 'VA07', 'WDC01', 'WDC02'
					)
				THEN 'Internal'
			ELSE ServiceArea
			END AS Vendor 
			into #TempVendor
	from #TempVendor1


IF OBJECT_ID('tempdb..#Response') IS NOT NULL
BEGIN
    DROP TABLE #Response;
END


SELECT
		RESP.ticket_ID
		,response_name AS response_code
		,locate_datetime AS FirstRes_Date
		,COALESCE(RTRIM(LOCATOR_NAME), 
					CASE 
                      WHEN (LOCATOR_FIRST_NAME = '' OR LOCATOR_FIRST_NAME IS NULL) AND (LOCATOR_LAST_NAME = '' OR LOCATOR_LAST_NAME IS NULL) THEN NULL
                      ELSE RTRIM(CONCAT(LOCATOR_FIRST_NAME, ' ', LOCATOR_LAST_NAME))
					  END, RTRIM(CONCAT(OPERATOR_FIRST_NAME, ' ', OPERATOR_LAST_NAME))) AS FR_Locator_Name
		,response_contractor AS FR_response_contractor
		,createdby_email
	into #Response
    FROM dbo.UTILISPHERE_TICKET_RESPONSE_T RESP
	INNER JOIN (
		SELECT
			TICKET_ID
      ,MIN(TICKET_RESPONSE_ID) TICKET_RESPONSE_ID
    FROM dbo.UTILISPHERE_TICKET_RESPONSE_T RESP
		GROUP BY TICKET_ID
		) max_resp
		ON max_resp.TICKET_ID = RESP.TICKET_ID
			AND max_resp.TICKET_RESPONSE_ID = RESP.TICKET_RESPONSE_ID




IF OBJECT_ID('tempdb..#TempFinaltable1') IS NOT NULL
BEGIN
    DROP TABLE #TempFinaltable1;
END
			

SELECT 
    tix.ticket_ID,
    tix.ticket_number,
    'Enterprise' AS Network,
    tix.call_center,
    tix.ticket_type,
    tix.place AS City,
    tix.county AS County,
    UPPER(tix.STATE) AS STATE,
    risk_score.risk_score,
	CASE 
		WHEN foldertovendor.Vendor IS NULL
			THEN 'Internal'
		ELSE foldertovendor.Vendor
		END AS AssignedContractor,
    coalesce(FolderToVendor.ServiceArea, tix.ticket_folder) as ServiceArea,
    FORMAT(tix.received_datetime, 'MM/dd/yyyy HH:mm:ss') AS received_datetime,
    CASE
        WHEN LOWER(TIX.TICKET_TYPE) = 'emergency' AND TIX.RECEIVED_DATETIME > TIX.DUE_DATETIME
            THEN FORMAT(DATEADD(HOUR, 2, TIX.RECEIVED_DATETIME), 'MM/dd/yyyy HH:mm:ss')
        WHEN LOWER(TIX.TICKET_TYPE) = 'emergency' AND DATEDIFF(HOUR, TIX.RECEIVED_DATETIME, TIX.DUE_DATETIME) < 2
            THEN FORMAT(DATEADD(HOUR, 2, TIX.DUE_DATETIME), 'MM/dd/yyyy HH:mm:ss')
        WHEN LOWER(TIX.TICKET_TYPE) IN ('rush', 'now', 'damage/exposed') AND TIX.STATE = 'CA'
            THEN FORMAT(DATEADD(HOUR, 2, TIX.RECEIVED_DATETIME), 'MM/dd/yyyy HH:mm:ss')
        WHEN LOWER(TIX.TICKET_TYPE) IN ('renew', 'amend')
            THEN FORMAT(calendar.due_date, 'MM/dd/yyyy') + ' ' + FORMAT(TIX.RECEIVED_DATETIME, 'HH:mm:ss')
        ELSE FORMAT(TIX.DUE_DATETIME, 'MM/dd/yyyy HH:mm:ss')
    END AS CalcDueDate,
    FORMAT(tir_otr.FirstRes_Date, 'MM/dd/yyyy HH:mm:ss') AS FirstRes_Date,
    FORMAT(tir_otc.LastRes_date, 'MM/dd/yyyy HH:mm:ss') AS LastRes_date,
    -- received to first response hours
    ROUND(DATEDIFF(MINUTE, tix.received_datetime, tir_otr.FirstRes_Date) , 2) AS RTR_Minutes,
    -- received to close hours
    ROUND(DATEDIFF(MINUTE, tix.received_datetime, tir_otc.LastRes_date) , 2) AS RTC_Minutes,
    CASE
        WHEN 
            CASE
                WHEN LOWER(TIX.TICKET_TYPE) = 'emergency' AND TIX.RECEIVED_DATETIME > TIX.DUE_DATETIME
                    THEN DATEADD(HOUR, 2, tix.received_datetime)
                WHEN LOWER(TIX.TICKET_TYPE) = 'emergency' AND DATEDIFF(HOUR, TIX.RECEIVED_DATETIME, TIX.DUE_DATETIME) < 2
                    THEN DATEADD(HOUR, 2, tix.due_datetime)
                WHEN LOWER(TIX.TICKET_TYPE) IN ('rush', 'now', 'damage/exposed') AND TIX.STATE = 'CA'
                    THEN DATEADD(HOUR, 2, tix.received_datetime)
                WHEN LOWER(TIX.TICKET_TYPE) IN ('renew', 'amend')
                    THEN CONVERT(DATETIME, FORMAT(calendar.due_date, 'MM/dd/yyyy') + ' ' + FORMAT(TIX.RECEIVED_DATETIME, 'HH:mm:ss'), 120)
                ELSE DATEADD(HOUR, 2, tix.due_datetime)
            END <= DATEADD(HOUR, 2, GETDATE())
        THEN 'Due'
        ELSE 'Not_Due'
    END AS Due_NotDue,
	TIX.OPERATOR,
    tir_otr.fr_locator_name AS otr_LocatorName,
    tir_otc.lr_locator_name AS otc_LocatorName,
    tir_otc.createdby_email AS otc_locatoremail,
    tir_otc.supervisor,
    tir_otc.response_code,
    CASE
        WHEN CONVERT(DATETIME, FORMAT(FirstRes_Date, 'MM/dd/yyyy HH:mm:ss'), 120) <=
            CASE
                WHEN LOWER(TIX.TICKET_TYPE) = 'emergency' AND TIX.RECEIVED_DATETIME > TIX.DUE_DATETIME
                    THEN DATEADD(HOUR, 2, TIX.RECEIVED_DATETIME)
                WHEN LOWER(TIX.TICKET_TYPE) = 'emergency' AND DATEDIFF(HOUR, TIX.RECEIVED_DATETIME, TIX.DUE_DATETIME) < 2
                    THEN DATEADD(HOUR, 2, TIX.DUE_DATETIME)
                WHEN LOWER(TIX.TICKET_TYPE) IN ('rush', 'now', 'damage/exposed', 'emer') AND TIX.STATE = 'CA'
                    THEN DATEADD(HOUR, 2, TIX.RECEIVED_DATETIME)
                WHEN LOWER(TIX.TICKET_TYPE) IN ('renew', 'amend')
                    THEN CONVERT(DATETIME, FORMAT(calendar.due_date, 'MM/dd/yyyy') + ' ' + FORMAT(TIX.RECEIVED_DATETIME, 'HH:mm:ss'), 120)
                ELSE CONVERT(DATETIME, FORMAT(TIX.DUE_DATETIME, 'MM/dd/yyyy HH:mm:ss'), 120)
            END
        THEN 1
        ELSE 0
    END AS OTRFlag,
    CASE
        WHEN CONVERT(DATETIME, FORMAT(LastRes_Date, 'MM/dd/yyyy HH:mm:ss'), 120) <=
            CASE
                WHEN LOWER(TIX.TICKET_TYPE) = 'emergency' AND TIX.RECEIVED_DATETIME > TIX.DUE_DATETIME
                    THEN DATEADD(HOUR, 2, TIX.RECEIVED_DATETIME)
                WHEN LOWER(TIX.TICKET_TYPE) = 'emergency' AND DATEDIFF(HOUR, TIX.RECEIVED_DATETIME, TIX.DUE_DATETIME) < 2
                    THEN DATEADD(HOUR, 2, TIX.DUE_DATETIME)
                WHEN LOWER(TIX.TICKET_TYPE) IN ('rush', 'now', 'damage/exposed') AND TIX.STATE = 'CA'
                    THEN DATEADD(HOUR, 2, TIX.RECEIVED_DATETIME)
                WHEN LOWER(TIX.TICKET_TYPE) IN ('renew', 'amend')
                    THEN CONVERT(DATETIME, FORMAT(calendar.due_date, 'MM/dd/yyyy') + ' ' + FORMAT(TIX.RECEIVED_DATETIME, 'HH:mm:ss'), 120)
                ELSE CONVERT(DATETIME, FORMAT(TIX.DUE_DATETIME, 'MM/dd/yyyy HH:mm:ss'), 120)
            END
        THEN 1
        ELSE 0
    END AS OTCFlag,
    CASE
        WHEN tir_otc.LastRes_date IS NULL AND
            CASE
                WHEN LOWER(TIX.TICKET_TYPE) = 'emergency' AND TIX.RECEIVED_DATETIME > TIX.DUE_DATETIME
                    THEN DATEADD(HOUR, 2, TIX.RECEIVED_DATETIME)
                WHEN LOWER(TIX.TICKET_TYPE) = 'emergency' AND DATEDIFF(HOUR, TIX.RECEIVED_DATETIME, TIX.DUE_DATETIME) < 2
                    THEN DATEADD(HOUR, 2, TIX.DUE_DATETIME)
                WHEN LOWER(TIX.TICKET_TYPE) IN ('rush', 'now', 'damage/exposed') AND TIX.STATE = 'CA'
                    THEN DATEADD(HOUR, 2, TIX.RECEIVED_DATETIME)
                WHEN LOWER(TIX.TICKET_TYPE) IN ('renew', 'amend')
                    THEN CONVERT(DATETIME, FORMAT(calendar.due_date, 'MM/dd/yyyy') + ' ' + FORMAT(TIX.RECEIVED_DATETIME, 'HH:mm:ss'), 120)
                ELSE CONVERT(DATETIME, FORMAT(TIX.DUE_DATETIME, 'MM/dd/yyyy HH:mm:ss'), 120)
            END < GETDATE()
        THEN 1
        ELSE 0
    END AS WIP_Past_DueFlag,
    TIX.DUE_DATETIME,
	TIR_OTR.FR_RESPONSE_CONTRACTOR,
	TIR_OTC.LR_RESPONSE_CONTRACTOR
INTO #TempFinaltable1
FROM dbo.UTILISPHERE_CTL_TICKET_RECENT_T tix
LEFT JOIN (
    SELECT c1.date_datetime AS rec_date, c2.date_datetime AS due_date
    FROM (
        SELECT 
            SUM(CASE
                WHEN is_us_holiday = 1 THEN 0
                WHEN is_weekend = 1 THEN 0
                ELSE 1
            END) OVER (ORDER BY date_datetime) AS cs1,
            calendar_t.date_datetime
        FROM SA_Staging.shared_dim.date AS calendar_t
    ) C1
    LEFT JOIN (
        SELECT 
            ROW_NUMBER() OVER (PARTITION BY cs2 ORDER BY date_datetime) AS rn,
            calendar_t.cs2,
            calendar_t.date_datetime
        FROM (
            SELECT 
                SUM(CASE
                    WHEN is_us_holiday = 1 THEN 0
                    WHEN is_weekend = 1 THEN 0
                    ELSE 1
                END) OVER (ORDER BY date_datetime) AS cs2,
                calendar_t.date_datetime
            FROM SA_Staging.shared_dim.date AS calendar_t
        ) calendar_t
    ) C2 ON c1.cs1 + 2 = c2.cs2 AND c2.rn = 1
) calendar ON CAST(tix.received_datetime AS date) = CAST(calendar.rec_date AS date)
LEFT JOIN (
    SELECT 
        TICKET_ID,
        SUBSTRING(LONG_DESCRIPTION, CHARINDEX('value: ', LONG_DESCRIPTION) + 7, LEN(LONG_DESCRIPTION)) AS Risk_Score
			FROM dbo.UTILISPHERE_TICKET_AUDIT_T
	WHERE SUBSTRING(LONG_DESCRIPTION, 0, 28) = 'Ticket Risk Score calculated'
	) risk_score
	ON risk_score.ticket_id = tix.ticket_id
LEFT JOIN #Response tir_otr
	ON tix.ticket_ID = tir_otr.ticket_ID
LEFT JOIN #TempLocator tir_otc
	ON tix.TICKET_ID = tir_otc.TICKET_ID
LEFT JOIN #TempVendor FolderToVendor
	ON foldertovendor.ticket_id = tix.ticket_id;


