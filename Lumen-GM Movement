ALTER PROCEDURE [report].[usp_gfs_waves_tasks_details] @iAgentJob varchar(1000) = NULL

--FOR TESTING: exec [report].[usp_gfs_waves_tasks_details]
AS
BEGIN
	SET NOCOUNT ON;

	--Declare a variable to handle the agent job NULL and apply the host name running if manual
	DECLARE @vAgentJob VARCHAR(1000) = isNull(@iAgentJob,'Manual Run ('+HOST_NAME()+')');
	DECLARE @vProcessName VARCHAR(200) = 'report_gfs_waves_tasks_details update';

	-----------------------------
	-- Process Start
	-----------------------------
	--Log Job Start with Server and Job Name included.  USE THIS ONE IF THE PROCEDURE IS CALLED FROM A JOB
EXEC dbo.sp_jv_update
 		 @reportname = @vProcessName
		,@updatetype = 0
		,@source_server = @@SERVERNAME 
		,@source_job = @vAgentJob


	TRUNCATE TABLE report.gfs_waves_tasks_details;

	BEGIN TRY	--STORED PROCEDURE BODY BEGIN

	DECLARE @p_hist_dt DATETIME = dbo.trunc(getdate())


IF OBJECT_ID('tempdb..#tasklist') IS NOT NULL
	DROP TABLE #tasklist;

SELECT DISTINCT task_name
INTO #tasklist
FROM task_details WITH (NOLOCK)
WHERE task_source = 'BPM'
	AND TASK_NAME LIKE '%test%assist%'

INSERT INTO #tasklist
VALUES ('InstallCrossConnect')
	,('InstallPreWireTransport')
	,('LOA/CFA Process Field Install')
	,('install_equipment')
	,('Install Equipment')
	,('Service Validate Field')
	,('Service Validate Field - Uncoordinated')

--select * from #tasklist
IF object_id('tempdb..#related_ords') IS NOT NULL
	DROP TABLE #related_ords;

SELECT *
INTO #related_ords
FROM related_orders_w_hybrids WITH (NOLOCK);

IF object_id('tempdb..#sou_limit') IS NOT NULL
	DROP TABLE #sou_limit;

SELECT DISTINCT
	k.order_item AS srvc_order_unit
	,k.primary_order_item AS orig_srvc_order_unit
	,k.unified_mrr AS mrr
	,k.customer_commit_dt as cust_commit_dt
	,k.prov_product as product_instance_id
	,k.source_system
	,'N' as cnr_flag --k.cnr_flag
	--,w.OMC_SOU
	,omc.OMC_SOU
	,k.product
	,k.product_family_name
	--,w.tester
	,omc.tester
	,k.order_number
	,w.[net ind] AS net_ind
	,w.[business org name] AS business_org_name
	,w.[cust req dt] AS cust_req_dt
	--,w.ccm
	--,omc.ccm
	,w.ccm_login as ccm
	--,w.CCMMngr
	,CCMMngr = isnull(d.mgr_nt_login,'Unknown')
	--,w.functional_group
	,case when	w.[prod type] = 'Level3 Waves Service' or w.bandwidth_grp in ('10G','10GE','2.5G') then 'Wave'
		when	w.[prov product] = 'EPL' then 'EPL'
		when	w.[prov family] = 'IP' then 'IP'
		when	w.[prov family] in ('Softswitch','Softswtich') then 'Voice'
		when	w.[prov product] like '%IP%' or  w.[prov product] = 'Internet' then 'IP'
		when	w.[prov family] in ('Dark Fiber','Gateway') then 'Infra'
		when	w.[prov product] = 'Private Room' then 'Infra'
		when	w.[prov product] like '%voice%' or  w.[prov product] = 'Trunk Group' or	w.[prov product] like '%POTS%' then 'Voice'
		when	w.[prov family] in ('Transport','DAL','CDN') then 'PL'
		when	w.[prov family] = 'Crossconnect' or	w.[prov product] = 'CrossConnect Bulk Cable' then 'XC'
		else 'Other'				
	end functional_group
	--,w.provmngr
	,provmngr = isnull(e.mgr_nt_login,'Unknown')
	,w.[orig cust commit dt rpt] AS orig_cust_commit_dt_rpt
	,k.bandwidth
	,w.sales_region
	,w.operating_region_cd
INTO #sou_limit
FROM #related_ords k WITH (NOLOCK)
--LEFT OUTER JOIN vw_monthly_opportunity_combined_allregions w WITH (NOLOCK) ON k.order_item = w.[srvc order unit]
LEFT OUTER JOIN tbl_k_mart_daily_w_metasolv_and_latam w WITH (NOLOCK) ON k.order_item = w.[srvc order unit]
left outer join dbo.CSD_IC_Employee d on w.ccm_login = d.nt_login and d.retired = 'n'
left join (
	SELECT
		 [Srvc Order Unit]
		,MAX(OMC_SOU) AS OMC_SOU
		,MAX(Provisioner) AS Provisioner
		,MAX(Tester) AS Tester
		--,MAX(CCM) AS CCM
	FROM sa_staging.dbo.xref_order_assignees with (nolock)
	GROUP BY [Srvc Order Unit]) omc ON k.order_item = omc.[srvc order unit]
--left outer join dbo.CSD_IC_Employee d on omc.ccm = d.nt_login and d.retired = 'n'
left outer join dbo.CSD_IC_Employee e on omc.provisioner = e.nt_login and e.retired = 'n'

WHERE
	k.sales_region in ('NA','EMEA')
	AND (k.product_family_name = 'wavelengths' OR k.functional_group = 'wave')
	AND w.[gl product family name] <> 'Colocation'
	AND isnull(w.long_term_customer_delay_flag, 'N') = 'N'
	AND (
		CASE 
			WHEN w.Off_net_resp_org_name IS NOT NULL
				AND charindex(':', w.Off_net_resp_org_name) = 0
				THEN w.Off_net_resp_org_name
			WHEN w.Off_net_resp_org_name IS NOT NULL
				THEN left(w.Off_net_resp_org_name, charindex(':', w.Off_net_resp_org_name) - 1)
			WHEN charindex(':', w.On_Net_resp_org_name) = 0
				THEN w.On_Net_resp_org_name
			ELSE left(w.On_Net_resp_org_name, charindex(':', w.On_Net_resp_org_name) - 1)
			END IN (
			'cti'
			,'gfs'
			,'cti waves'
			)
		OR CASE 
			WHEN charindex(':', w.On_Net_resp_org_name) = 0
				THEN w.On_Net_resp_org_name
			ELSE left(w.On_Net_resp_org_name, charindex(':', w.On_Net_resp_org_name) - 1)
			END IN ( 
			'cti'
			,'gfs'
			,'cti waves'
			)
		)
	AND (
		w.On_Net_resp_org_name IS NULL
		OR w.On_Net_resp_org_name <> 'CTI: Parked'
		)
	AND (
		w.Off_net_resp_org_name IS NULL
		OR w.Off_net_resp_org_name <> 'CTI: Parked'
		)
	AND k.customer_commit_dt IS NOT NULL
	AND k.is_primary = 1

--select * from #sou_limit where order_number  = '1-1496488514'
IF OBJECT_ID('tempdb..#tsk_join_prep') IS NOT NULL
	DROP TABLE #tsk_join_prep;

SELECT *
INTO #tsk_join_prep
FROM (

	SELECT w.primary_order_item
		,w.order_item as task_order_item
		,w.source
		,w.source_system
		,sl.sales_region
		,sl.operating_region_cd
		,1 AS subquery_id
	FROM #related_ords w
	INNER JOIN #sou_limit sl ON sl.srvc_order_unit = w.primary_order_item
	WHERE w.omc_order_item IS NOT NULL

	UNION
	
	SELECT w.primary_order_item
		,w.OMC_service_order AS task_order_item
		,w.source
		,w.source_system
		,sl.sales_region
		,sl.operating_region_cd
		,2 AS subquery_id
	FROM #related_ords w
	INNER JOIN #sou_limit sl ON sl.srvc_order_unit = w.primary_order_item
	WHERE OMC_service_order IS NOT NULL
	
	UNION
	
	SELECT w.primary_order_item
		,w.order_item AS task_order_item
		,w.source
		,w.source_system
		,sl.sales_region
		,sl.operating_region_cd
		,3 AS subquery_id
	FROM #related_ords w
	INNER JOIN #sou_limit sl ON sl.srvc_order_unit = w.primary_order_item
	WHERE w.order_item IS NOT NULL
		AND w.source LIKE 'related%'
		AND (
			w.order_item <> omc_service_order
			OR omc_service_order IS NULL
			)
		AND (w.order_item <> w.omc_order_item)
	
	UNION
	
	SELECT w.primary_order_item
		,sl.product_instance_id AS task_order_item
		,w.source
		,sl.source_system
		,sl.sales_region
		,sl.operating_region_cd
		,4 AS subquery_id
	FROM #related_ords w
	INNER JOIN #sou_limit sl ON sl.srvc_order_unit = w.primary_order_item
	WHERE sl.srvc_order_unit IS NOT NULL AND w.source NOT IN ('hybrid')
	
	UNION
	
	SELECT primary_order_item
		,w.OMC_order_item --right(w.OMC_order_item, len(w.OMC_order_item) - 9) AS task_order_item
		,w.source
		,sl.source_system
		,sl.sales_region
		,sl.operating_region_cd
		,5 AS subquery_id
	FROM #related_ords w
	INNER JOIN #sou_limit sl ON sl.srvc_order_unit = primary_order_item
	WHERE order_item IS NOT NULL
		AND w.source_system = 'pipeline'
		AND charindex('-', w.OMC_order_item) > 0
		AND len(w.OMC_order_item) > 9
	
	UNION
	
	SELECT primary_order_item
		,replace(primary_order_item, '/', '-') AS task_order_item
		,w.source
		,sl.source_system
		,sl.sales_region
		,sl.operating_region_cd
		,6 AS subquery_id
	FROM #related_ords w
	INNER JOIN #sou_limit sl ON sl.srvc_order_unit = primary_order_item
	WHERE order_item IS NOT NULL
	
	UNION
	
	SELECT primary_order_item
		,k.[srvc order unit] AS task_order_item
		,source
		,w.source_system
		,sl.sales_region
		,sl.operating_region_cd
		,7 AS subquery_id
	FROM #related_ords w
	INNER JOIN #sou_limit sl --UPDATE 004
		ON sl.srvc_order_unit = primary_order_item
	LEFT OUTER JOIN tbl_k_mart_daily_w_metasolv_and_latam k ON w.omc_service_order = k.[product instance id]
	WHERE order_item IS NOT NULL
	) a;

