SELECT a.*
	,row_number() OVER (
		PARTITION BY primary_order_item ORDER BY primary_order_item
			,order_item
		) AS UNI_NO
	,gfs_a_city.REGION
	,gfs_a_city.DIVISION
INTO #address
FROM (
	SELECT DISTINCT wrh.primary_order_item
		,wrh.order_item
		,pl.onnet_ind
		,line1_addr
		,city_name
		,state_cd
		,postal_cd
		,cop.cust_service_id
	FROM #related_ords wrh
	INNER JOIN #sou_limit r ON r.srvc_order_unit = wrh.primary_order_item
		AND r.order_number = wrh.order_number
	LEFT OUTER JOIN [tbl_CODS_PRODUCT_LOCATION] pl ON pl.serv_order_nbr = wrh.order_item
	LEFT OUTER JOIN tbl_CODS_DSL_V_Customer_Order_Product cop ON wrh.order_item = cop.serv_order_nbr
		AND cop.serv_order_active_ind = 'Y'
	WHERE wrh.prov_product IN (
			'uni'
			,'wholesale uni'
			)
		AND cop.serv_order_action_typ IN (
			'install'
			,'change'
			)
		AND pl.endpnt_typ = 'Access A'
	) a
LEFT OUTER JOIN [PND].[dbo].[NetBuildGFS_Regions_Cities] gfs_a_city ON gfs_a_city.city = a.CITY_NAME
	AND gfs_a_city.STATE = a.STATE_CD;

