IF OBJECT_ID('tempdb..#task_details_join') IS NOT NULL
	DROP TABLE #task_details_join;

CREATE TABLE #task_details_join (
	primary_order_item VARCHAR(256)
	,task_order_item VARCHAR(256)
	,source VARCHAR(16)
	,sales_region VARCHAR(256)
	,operating_region_cd VARCHAR(256)
	,task_name VARCHAR(512)
	,task_assignee VARCHAR(512)
	,task_due_date DATETIME
	,work_site_location VARCHAR(256)
	,dispatch_gateway_CLLI VARCHAR(256)
	,service_id VARCHAR(256)
	--,task_id NUMERIC(38, 0)
	,task_id VARCHAR(64)
	,tsk_src VARCHAR(16)
	,task_status VARCHAR(32)
	,task_start_time DATETIME
	,task_end_time DATETIME
	,rownum INT
	,dept VARCHAR(64)
	,title VARCHAR(64)
	,mgr VARCHAR(256)
	)

INSERT INTO #task_details_join
SELECT DISTINCT b.*
	,isnull(g1.dept_name, b.task_assignee) AS dept
	,isnull(g1.job_title, b.task_assignee) AS title
	,isnull(g1.supervisor_name, b.task_assignee) AS mgr
FROM (
	SELECT a.*
		,row_number() OVER (
			PARTITION BY task_id ORDER BY CASE 
					WHEN source = 'related items'
						THEN 1
					WHEN source = 'related orders'
						THEN 2
					WHEN source = 'hybrid'
						THEN 3
					END
				,primary_order_item desc
				,isnull(task_due_date, '2099-12-31')
			) AS rownum
	FROM (
		SELECT DISTINCT w.primary_order_item
			,w.task_order_item
			,w.source
			,w.sales_region
			,w.operating_region_cd
			,CASE 
				WHEN w.source = 'hybrid'
					THEN 'Hybrid: ' + tsk.task_name
				WHEN w.source LIKE 'related order%'
					THEN 'Related: ' + tsk.task_name
				ELSE tsk.task_name
				END AS task_name
			,CASE 
				WHEN tsk.task_assignee = 'walsh.brian' THEN 'walsh.brian2' ELSE tsk.task_assignee END AS task_assignee
			,tsk.task_due_date
			,tsk.work_site_location
			,tsk.dispatch_gateway_CLLI
			,tsk.service_id
			--,cast(tsk.task_id AS NUMERIC(38, 0)) AS task_id
			,tsk.task_id
			,'task_details' AS tsk_src
			,tsk.cods_task_status AS task_status
			,tsk.task_start_date
			,tsk.task_end_date AS task_end_time
		FROM task_details tsk WITH (NOLOCK)
		INNER JOIN #tsk_join_prep w ON w.task_order_item = tsk.task_sou
		INNER JOIN #tasklist tl	on tsk.task_name = tl.task_name
		WHERE tsk.task_derived_status IN (
				'Completed'
				, 'In Progress'
				, 'Manual Task'
				, 'Pending')
			AND (tsk.task_start_date IS NOT NULL OR tsk.task_assignee IS NOT NULL)
			--AND w.source not in ('EON', 'GC_EON', 'Global Crossing')
		) a
	) b
LEFT OUTER JOIN galcapture g1 WITH (NOLOCK) ON b.task_assignee = g1.nt_login
WHERE rownum = 1

