EXEC bira.ListHoursWorked
@DATE_FROM = ?, 
@DATE_TO = ?
WITH RESULT SETS
	((
		crew_id int null,
		crew varchar(200) null,
		cuid_supv varchar(20) null,
		cuid_tech varchar(20) null,
		[date] datetime null,
		work_week_no int null,
		work_week_day int null,
		dow varchar(3) null,
		hrs_shift decimal(10,3) null,
		hrs_ot decimal(10,3) null,
		hrs_off decimal(10,3) null,
		hrs_worked decimal(10,3) null,
		hrs_worked_sap decimal(10,3) null,
		is_holiday tinyint null,
		is_scheduled tinyint null,
		updated_ts datetime null
	))
